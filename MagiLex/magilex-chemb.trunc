    desc:"1族・2族元素の性質、ソルベー法、酸化還元",
    questions:[
      {stem:"アルカリ金属（ナトリウムなど）の単体の保存方法として正しいものは", reading:"（アルカリ金属）", answer:"石油（灯油）中に保存する", wrong:["水中に保存する","空気中にそのまま置く","濃硫酸中に保存する","二酸化炭素中に保存する"], extra:"水・酸素と激しく反応するため石油中で保存。単体は銀白色で軟らかく軽い"},
      {stem:"アルカリ金属の塩の水への溶けやすさについて正しいものは", reading:"（アルカリ金属の塩）", answer:"炭酸塩・硫酸塩ともに水によく溶ける", wrong:["炭酸塩・硫酸塩は水に溶けにくい","炭酸塩のみ溶けにくい","硫酸塩のみ溶けにくい","すべて水に不溶"], extra:"アルカリ金属の塩はほとんど水に溶ける（一般に沈殿をつくりにくい）"},
      {stem:"水酸化ナトリウムは工業的に何を電気分解して製造されるか", reading:"（NaOHの製法）", answer:"塩化ナトリウム水溶液", wrong:["塩化ナトリウムの融解液","炭酸ナトリウム水溶液","硫酸ナトリウム水溶液","塩化カリウム水溶液"], extra:"食塩水の電気分解（陽イオン交換膜法）で NaOH・Cl₂・H₂ を得る"},
      {stem:"炭酸カルシウムを加熱すると分解して生じる物質は", reading:"（2族元素）", answer:"酸化カルシウム CaO（と CO₂）", wrong:["水酸化カルシウム","炭素","硫酸カルシウム","塩化カルシウム"], extra:"CaCO₃ → CaO + CO₂。生石灰 CaO に水を加えると消石灰 Ca(OH)₂ になる"},
      {stem:"硫酸カルシウム CaSO₄ の水への溶けやすさは", reading:"（2族の硫酸塩）", answer:"水に溶けにくい", wrong:["水によく溶ける","熱水にのみ溶ける","酸性水にのみ不溶","すべて溶ける"], extra:"2族の硫酸塩（CaSO₄・BaSO₄）は水に溶けにくい。硫酸マグネシウムは溶けやすい"},
      {stem:"マグネシウム Mg が高温の水蒸気と反応すると発生する気体は", reading:"（2族の反応）", answer:"水素", wrong:["酸素","二酸化炭素","窒素","塩素"], extra:"Mg + H₂O → MgO + H₂（高温の水蒸気と反応）。常温の水とはほとんど反応しない"},
      {stem:"アンモニアソーダ法（ソルベー法）で工業的に製造される物質は", reading:"（ソルベー法）", answer:"炭酸ナトリウム Na₂CO₃", wrong:["水酸化ナトリウム NaOH","炭酸水素ナトリウム NaHCO₃","塩化カルシウム CaCl₂","硫酸ナトリウム"], extra:"目的物は Na₂CO₃。NaCl 飽和水溶液に NH₃ と CO₂ を通じて反応させる"},
      {stem:"アンモニアソーダ法で、溶解度が小さいために沈殿する物質は", reading:"（ソルベー法）", answer:"炭酸水素ナトリウム NaHCO₃", wrong:["炭酸ナトリウム Na₂CO₃","塩化アンモニウム NH₄Cl","塩化カルシウム CaCl₂","水酸化ナトリウム"], extra:"NaCl + CO₂ + NH₃ + H₂O → NaHCO₃↓ + NH₄Cl。NaHCO₃ を熱分解して Na₂CO₃ を得る"},
      {stem:"二クロム酸カリウム（橙赤色）の水溶液に塩基を加えると変化する色は", reading:"（クロムの酸化数）", answer:"黄色（クロム酸イオン）になる", wrong:["無色になる","緑色になる","赤紫色になる","青色になる"], extra:"Cr₂O₇²⁻（橙赤・酸性）⇄ 2CrO₄²⁻（黄・塩基性）。クロムの酸化数は+6のまま"},
      {stem:"過マンガン酸イオン MnO₄⁻ が酸性溶液中で酸化剤としてはたらくとき、マンガンの酸化数はどう変化するか", reading:"（酸化数の変化）", answer:"+7 から +2 に減少する", wrong:["+7 から +4 に減少する","+7 から +6 に減少する","+2 から +7 に増加する","+4 から +2 に減少する"], extra:"酸性では MnO₄⁻ → Mn²⁺（ほぼ無色）。中性・塩基性では +4（MnO₂）になる"}
    ]
  },

  // ===== 化学205: 金属の製錬（銅・鉄・アルミニウム） =====
  {
    id:"cbeta_metallurgy",
    name:"金属の製錬・各論（Cu・Fe・Al）",
    icon:"⛏️",
    mode:"exam_chem",
    desc:"銅の電解精錬、鉄の製錬、アルミニウムの溶融塩電解",
    questions:[
      {stem:"銅の電解精錬で、陽極・陰極に用いるものの正しい組合せは", reading:"（電解精錬）", answer:"陽極＝粗銅、陰極＝純銅", wrong:["陽極＝純銅、陰極＝粗銅","陽極＝黄銅鉱、陰極＝鉄","陽極＝炭素、陰極＝粗銅","陽極＝純銅、陰極＝炭素"], extra:"硫酸酸性の硫酸銅(II)水溶液を電解液とし、陰極に純銅が析出する"},
      {stem:"粗銅の電解精錬で、不純物のうち陽極の下に沈む（陽極泥になる）金属は", reading:"（電解精錬）", answer:"銀 Ag・金 Au", wrong:["亜鉛 Zn・鉄 Fe","鉛 Pb・スズ Sn","アルミニウム Al・マグネシウム Mg","ナトリウム Na・カリウム K"], extra:"Cu よりイオン化傾向が小さい Ag・Au は溶けず陽極泥に。大きい Zn・Fe は溶け出す"},
      {stem:"黄銅鉱を溶鉱炉で処理して得られる、電解精錬前の純度の低い銅を何というか", reading:"（銅の製錬）", answer:"粗銅", wrong:["純銅","銑鉄","鋼","青銅"], extra:"黄銅鉱 CuFeS₂ → 硫化銅(I) → 転炉で空気を送り粗銅（純度約99%）を得る"},
      {stem:"赤鉄鉱などを、コークスから生じる一酸化炭素で還元して得られる、炭素を約4%含む鉄を何というか", reading:"（鉄の製錬）", answer:"銑鉄", wrong:["鋼","純鉄","ステンレス鋼","鋳鉄でない軟鉄"], extra:"溶鉱炉で得た銑鉄は炭素約4%で硬くもろい。転炉で炭素を減らすと鋼になる"},
      {stem:"鉄にクロムとニッケルを加えた、さびにくい合金を何というか", reading:"（合金）", answer:"ステンレス鋼", wrong:["ジュラルミン","黄銅（真鍮）","青銅","はんだ"], extra:"ステンレス鋼は Fe-Cr-Ni の合金。ジュラルミンは Al-Cu-Mg で軽く航空機に使う"},
      {stem:"鉄(III)イオンを含む水溶液にチオシアン酸カリウム水溶液を加えると呈する色は", reading:"（鉄の検出）", answer:"血赤色", wrong:["濃青色","黄褐色","緑色","無色"], extra:"Fe³⁺ ＋ SCN⁻ → 血赤色。Fe³⁺ の検出に用いる。濃青色はヘキサシアニド鉄との反応"},
      {stem:"アルミニウムを工業的に得る方法として正しいものは", reading:"（アルミニウムの製法）", answer:"酸化アルミニウムの溶融塩電解（氷晶石を融剤に使用）", wrong:["塩化アルミニウム水溶液の電気分解","アルミニウムイオンを含む水溶液の電気分解","コークスによる還元","一酸化炭素による還元"], extra:"Al はイオン化傾向が大きく水溶液電解では得られない。Al₂O₃ を氷晶石とともに融解し電解"},
      {stem:"アルミニウムの粉末と酸化鉄(III)の混合物に点火すると、融解した鉄が得られる反応を何というか", reading:"（テルミット反応）", answer:"テルミット反応", wrong:["ソルベー反応","接触法","不動態化","アマルガム反応"], extra:"2Al + Fe₂O₃ → Al₂O₃ + 2Fe。Al の強い還元力を利用。レールの溶接などに使う"},
      {stem:"アルミニウムに銅やマグネシウムなどを加えた、軽くて丈夫な合金を何というか", reading:"（合金）", answer:"ジュラルミン", wrong:["ステンレス鋼","黄銅","青銅","はんだ"], extra:"ジュラルミン（Al-Cu-Mg）は軽量で強度が高く、航空機の機体などに使われる"},
      {stem:"アルミニウムの表面を人工的に酸化被膜で覆って耐食性を高めた製品を何というか", reading:"（表面処理）", answer:"アルマイト", wrong:["トタン","ブリキ","めっき鋼板","アマルガム"], extra:"Al は空気中で酸化被膜をつくる。人工的に厚い酸化被膜をつけたものがアルマイト"}
    ]
  },

  // ===== 化学206: アンモニア・硝酸の製法／14〜16族・ハロゲン =====
  {
    id:"cbeta_industrial_nonmetal",
    name:"工業的製法・非金属元素",
    icon:"🏭",
    mode:"exam_chem",
    desc:"ハーバー法・オストワルト法、14〜16族、ハロゲン",
    questions:[
      {stem:"窒素と水素からアンモニアを工業的に合成する方法を何というか", reading:"（工業的製法）", answer:"ハーバー・ボッシュ法", wrong:["オストワルト法","接触法","ソルベー法","ハーバー・オストワルト法"], extra:"N₂ + 3H₂ → 2NH₃。四酸化三鉄 Fe₃O₄ を主成分とする触媒を用いる"},
      {stem:"アンモニアを酸化して硝酸を工業的に製造する方法を何というか", reading:"（工業的製法）", answer:"オストワルト法", wrong:["ハーバー・ボッシュ法","接触法","ソルベー法","電解法"], extra:"NH₃ を白金触媒で酸化（4NH₃+5O₂→4NO+6H₂O）し、順に NO₂、HNO₃ にする"},
      {stem:"オストワルト法で、アンモニアを酸化する第一段階で用いる触媒は", reading:"（触媒）", answer:"白金 Pt", wrong:["四酸化三鉄 Fe₃O₄","酸化バナジウム(V) V₂O₅","酸化マンガン(IV)","ニッケル Ni"], extra:"4NH₃ + 5O₂ → 4NO + 6H₂O の触媒は白金。接触法（硫酸）の触媒は V₂O₅"},
      {stem:"ケイ素 Si の天然での存在の仕方として正しいものは", reading:"（14族）", answer:"単体では存在せず、主に酸化物（SiO₂）として存在する", wrong:["天然に単体として多量に存在する","金属光沢のある液体として存在する","気体として存在する","塩としてのみ存在する"], extra:"炭素は単体（黒鉛・ダイヤ）で存在するが、ケイ素は化合物（二酸化ケイ素・ケイ酸塩）として存在"},
      {stem:"ケイ酸を加熱・脱水して得られる、乾燥剤に使われる固体を何というか", reading:"（14族）", answer:"シリカゲル", wrong:["ソーダ石灰","生石灰","ゼオライト","活性炭"], extra:"シリカゲルは多孔質で吸湿性が高く乾燥剤に使う。塩化コバルトを含ませ水分検出に利用"},
      {stem:"過酸化水素 H₂O₂ が過マンガン酸カリウムと反応するとき、H₂O₂ ははたらきとして何か", reading:"（酸化還元）", answer:"還元剤", wrong:["酸化剤","触媒","中和剤","脱水剤"], extra:"H₂O₂ は相手により酸化剤にも還元剤にもなる。強い酸化剤 KMnO₄ に対しては還元剤"},
      {stem:"ハロゲンの単体のうち、最も酸化力が強いものは", reading:"（ハロゲン）", answer:"フッ素 F₂", wrong:["塩素 Cl₂","臭素 Br₂","ヨウ素 I₂","アスタチン At₂"], extra:"酸化力は F₂ > Cl₂ > Br₂ > I₂。原子番号が小さいほど強い"},
      {stem:"ハロゲン化銀のうち、水に溶けやすいものは", reading:"（ハロゲン化銀）", answer:"フッ化銀 AgF", wrong:["塩化銀 AgCl","臭化銀 AgBr","ヨウ化銀 AgI","すべて溶けにくい"], extra:"AgF は水に溶ける。AgCl（白）・AgBr（淡黄）・AgI（黄）は水に溶けにくい"},
      {stem:"塩素を水に溶かしたとき生じる、漂白・殺菌作用を示す物質は", reading:"（ハロゲン）", answer:"次亜塩素酸 HClO（と塩酸）", wrong:["塩素酸のみ","過塩素酸","塩化水素のみ","亜塩素酸のみ"], extra:"Cl₂ + H₂O ⇄ HCl + HClO。次亜塩素酸 HClO の酸化作用で漂白・殺菌する"},
      {stem:"ホタル石（フッ化カルシウム）に濃硫酸を加えて加熱すると得られる気体は", reading:"（ハロゲン化水素）", answer:"フッ化水素 HF", wrong:["塩化水素 HCl","フッ素 F₂","二酸化硫黄 SO₂","硫化水素 H₂S"], extra:"CaF₂ + H₂SO₄ → CaSO₄ + 2HF。HF はガラス（SiO₂）を溶かす"}
    ]
  },

  // ===== 化学207: 有機化学の基礎（官能基・元素分析・異性体） =====
  {
    id:"cbeta_organic_basics",
    name:"有機化学の基礎・元素分析",
    icon:"🧬",
    mode:"exam_chem",
    desc:"官能基・元素分析・不飽和度・シストランス異性体",
    questions:[
      {stem:"メタノールやフェノールに共通して含まれる官能基は", reading:"（官能基）", answer:"ヒドロキシ基 −OH", wrong:["カルボキシ基 −COOH","ホルミル基（アルデヒド基）−CHO","エーテル結合 −O−","エステル結合 −COO−"], extra:"メタノール CH₃OH・フェノール C₆H₅OH はともに −OH をもつ"},
      {stem:"有機化合物で、炭素原子どうしが次々に結合して多様な化合物をつくるときの結合の種類は", reading:"（有機化合物の特徴）", answer:"共有結合", wrong:["イオン結合","金属結合","配位結合","水素結合"], extra:"炭素は4本の共有結合で鎖状・環状に多様な骨格をつくる。有機化合物の種類が多い理由"},
      {stem:"元素分析で、試料の燃焼で生じた水 H₂O を吸収させる物質は", reading:"（元素分析）", answer:"塩化カルシウム", wrong:["ソーダ石灰","酸化銅(II)","活性炭","硫酸バリウム"], extra:"燃焼で生じた H₂O は塩化カルシウム管、CO₂ はソーダ石灰管の順で吸収させる"},
      {stem:"元素分析で、試料の燃焼で生じた二酸化炭素 CO₂ を吸収させる物質は", reading:"（元素分析）", answer:"ソーダ石灰", wrong:["塩化カルシウム","酸化銅(II)","二酸化マンガン","濃硫酸"], extra:"CO₂ 吸収はソーダ石灰。順序を逆にすると水も CO₂ 管に吸われ誤差になる"},
      {stem:"元素分析の燃焼管に入れる酸化銅(II)の役割は", reading:"（元素分析）", answer:"試料を完全に酸化（燃焼）させる", wrong:["水を吸収する","二酸化炭素を吸収する","窒素を取り除く","温度を下げる"], extra:"酸化銅(II) は不完全燃焼で生じた CO などを酸化し、完全燃焼させる助燃剤"},
      {stem:"炭素・水素・酸素からなる化合物で、C:H:O の物質量比が 1:2:1 のとき、その組成式は", reading:"（組成式）", answer:"CH₂O", wrong:["C₂H₄O","CHO","C₂H₆O","CH₄O"], extra:"各元素の質量をモル質量で割り、最も簡単な整数比にすると組成式が求まる"},
      {stem:"分子式 CₓHᵧO₂ で表される化合物の不飽和度（環＋二重結合の数）を表す式は", reading:"（不飽和度）", answer:"x − y/2 + 1", wrong:["x + y/2 − 1","(x−y)/2 + 1","(x+y)/2 − 1","x − y/2 + 2"], extra:"不飽和度＝(2x+2−y)/2。酸素は不飽和度に影響しない"},
      {stem:"次のうちシス−トランス異性体（幾何異性体）が存在するものは", reading:"（幾何異性体）", answer:"HOOC−CH=CH−COOH", wrong:["CH₂=CH−COOH","CH₃−CH₂−COOH","CH₃−CH(OH)−COOH","HOOC−(CH₂)₄−COOH"], extra:"二重結合の各炭素に異なる置換基があると幾何異性体をもつ。マレイン酸（シス）とフマル酸（トランス）"},
      {stem:"有機化合物が一般に低い融点・沸点を示す主な理由は", reading:"（有機化合物の特徴）", answer:"多くが分子からなり、分子間力が弱いため", wrong:["イオン結合でできているため","金属結合をもつため","共有結合の結晶をつくるため","水素結合しかもたないため"], extra:"分子性物質は分子間力（ファンデルワールス力など）で集まるため融点・沸点が低い傾向"}
    ]
  },

  // ===== 化学208: 不飽和炭化水素（アルケン・アルキン） =====
  {
    id:"cbeta_hydrocarbon",
    name:"不飽和炭化水素・付加反応",
    icon:"🔗",
    mode:"exam_chem",
    desc:"アルケン・アルキンの構造と付加反応、臭素の脱色",
    questions:[
      {stem:"炭素間に二重結合を1つもつ鎖式炭化水素（アルケン）の一般式は", reading:"（アルケン）", answer:"CₙH₂ₙ", wrong:["CₙH₂ₙ₊₂","CₙH₂ₙ₋₂","CₙHₙ","CₙH₂ₙ₊₁"], extra:"アルカンは CₙH₂ₙ₊₂、アルケン CₙH₂ₙ、アルキン CₙH₂ₙ₋₂"},
      {stem:"炭素間に三重結合を1つもつ鎖式炭化水素（アルキン）の一般式は", reading:"（アルキン）", answer:"CₙH₂ₙ₋₂", wrong:["CₙH₂ₙ","CₙH₂ₙ₊₂","CₙHₙ","CₙH₂ₙ₋₄"], extra:"最も簡単なアルキンはアセチレン C₂H₂"},
      {stem:"アルケンやアルキンに臭素の四塩化炭素溶液を加えると、臭素の赤褐色が消える。この反応は", reading:"（不飽和の検出）", answer:"付加反応（臭素が二重・三重結合に付加する）", wrong:["置換反応","脱離反応","縮合反応","酸化反応"], extra:"C=C や C≡C が臭素を付加して脱色する。不飽和結合の検出に利用される"},
      {stem:"アセチレン C₂H₂ に触媒（硫酸水銀(II)）を用いて水を付加させると生成する物質は", reading:"（アルキンへの付加）", answer:"アセトアルデヒド", wrong:["エタノール","酢酸","アセトン","エチレングリコール"], extra:"付加でできるビニルアルコールが不安定で、ただちにアセトアルデヒドに変わる"},
      {stem:"アセチレン分子で、三重結合をつくる炭素まわりの結合角は", reading:"（アルキンの構造）", answer:"180°（直線形）", wrong:["120°（平面三角形）","109.5°（正四面体形）","90°","104.5°"], extra:"C≡C は直線形。エチレンの C=C まわりは平面（約120°）"},
      {stem:"エチレン（エテン）に水を付加させると得られる物質は", reading:"（アルケンへの付加）", answer:"エタノール", wrong:["アセトアルデヒド","酢酸","ジエチルエーテル","エチレングリコール"], extra:"CH₂=CH₂ + H₂O → C₂H₅OH（リン酸触媒）。工業的なエタノール製法"}
    ]
  },

  // ===== 化学209: アルコール・エーテル・アルデヒド・ケトン =====
  {
    id:"cbeta_alcohol_carbonyl",
    name:"アルコール・アルデヒド・ケトン",
    icon:"🍶",
    mode:"exam_chem",
    desc:"アルコールの酸化・エーテル・カルボニル化合物の識別",
    questions:[
      {stem:"第一級アルコールである1-プロパノールを二クロム酸カリウムの硫酸酸性水溶液で酸化すると、まず生じるものは", reading:"（アルコールの酸化）", answer:"アルデヒド（プロピオンアルデヒド）", wrong:["アセトン（ケトン）","カルボン酸を経ずにエステル","エーテル","アルカン"], extra:"第一級アルコール→アルデヒド→カルボン酸。アセトンは第二級の2-プロパノールを酸化して得る"},
      {stem:"第二級アルコールである2-プロパノールを酸化すると得られる物質は", reading:"（アルコールの酸化）", answer:"アセトン（ケトン）", wrong:["プロピオンアルデヒド","プロピオン酸","ジメチルエーテル","プロパン"], extra:"第二級アルコールは酸化されてケトンになる。それ以上は酸化されにくい"},
      {stem:"エタノールを約130〜140℃に加熱した濃硫酸に加えると、2分子から水がとれて生じる物質は", reading:"（脱水・縮合）", answer:"ジエチルエーテル", wrong:["エチレン","アセトアルデヒド","酢酸","ジメチルエーテル"], extra:"約160〜170℃では分子内脱水でエチレンになる。温度で生成物が変わる"},
      {stem:"アルコールと金属ナトリウムが反応して発生する気体は", reading:"（アルコールの性質）", answer:"水素", wrong:["酸素","二酸化炭素","メタン","エタン"], extra:"2R-OH + 2Na → 2R-ONa + H₂。エーテルは -OH をもたないので反応しない"},
      {stem:"アルデヒドとケトンを区別できるフェーリング液との反応で生じる赤色沈殿は", reading:"（アルデヒドの検出）", answer:"酸化銅(I) Cu₂O", wrong:["酸化銅(II) CuO","酸化鉄(II)","酸化銀","水酸化銅(II)"], extra:"アルデヒドはフェーリング液を還元し赤色の Cu₂O を生じる。ケトンは反応しない"},
      {stem:"フェーリング液や銀鏡反応が示す、アルデヒドがもつ性質は", reading:"（アルデヒドの性質）", answer:"還元性（自身は酸化されやすい）", wrong:["酸化性","塩基性","付加重合性","昇華性"], extra:"アルデヒド基 -CHO は相手を還元し、自身はカルボキシ基 -COOH に酸化される"},
      {stem:"メタノールを酸化して得られる、水に溶けやすく殺菌・消毒に使われるアルデヒドは", reading:"（ホルムアルデヒド）", answer:"ホルムアルデヒド", wrong:["アセトアルデヒド","アセトン","ギ酸","酢酸"], extra:"約37%水溶液がホルマリン。最も簡単なアルデヒド HCHO"}
    ]
  },

  // ===== 化学210: カルボン酸・異性体・エステル化 =====
  {
    id:"cbeta_carboxyl_ester",
    name:"カルボン酸・異性体・エステル化",
    icon:"🧴",
    mode:"exam_chem",
    desc:"カルボン酸の性質、鏡像・幾何異性体、エステル化とけん化",
    questions:[
      {stem:"カルボキシ基 −COOH をもつ化合物の水溶液が示す性質は", reading:"（カルボン酸）", answer:"弱い酸性", wrong:["弱い塩基性","中性","強い塩基性","両性"], extra:"カルボン酸は水中でわずかに電離して酸性を示す。炭酸より強く、フェノールより強い"},
      {stem:"4つの異なる原子・原子団が結合した炭素（不斉炭素原子）があると存在する異性体は", reading:"（鏡像異性体）", answer:"鏡像異性体（光学異性体）", wrong:["幾何異性体（シス−トランス）","構造異性体","位置異性体","官能基異性体"], extra:"互いに重ね合わせられない鏡像の関係。乳酸 C₃H₆O₃ などにみられる"},
      {stem:"不飽和ジカルボン酸で、シス形のマレイン酸とトランス形のフマル酸は互いに何異性体か", reading:"（幾何異性体）", answer:"幾何異性体（シス−トランス異性体）", wrong:["鏡像異性体","構造異性体","位置異性体","同位体"], extra:"C=C まわりの立体配置の違い。マレイン酸（シス）だけ加熱で無水マレイン酸になる"},
      {stem:"加熱すると分子内で脱水して酸無水物（無水マレイン酸）を生じるのは、シス形・トランス形のどちらか", reading:"（幾何異性体）", answer:"シス形（マレイン酸）", wrong:["トランス形（フマル酸）","両方とも生じる","どちらも生じない","加熱では判別できない"], extra:"シス形は2つの −COOH が近いので分子内脱水できる。トランス形（フマル酸）は昇華するだけ"},
      {stem:"カルボン酸とアルコールから、酸を触媒として水がとれてエステルが生じる反応の特徴は", reading:"（エステル化）", answer:"可逆反応で、平衡状態に達する", wrong:["不可逆反応で完全に進む","塩基が触媒として必要","気体が発生する","室温で瞬時に完結する"], extra:"エステル化は可逆。効率を上げるには生成する水を除くか、生成物を留去する"},
      {stem:"エステルに水酸化ナトリウム水溶液を加えて加熱し、カルボン酸の塩とアルコールに分解する不可逆反応を何というか", reading:"（けん化）", answer:"けん化", wrong:["エステル化","中和","付加","縮合重合"], extra:"けん化はエステルの塩基による加水分解。セッケンの製造にも利用される"}
    ]
  },

  // ===== 化学211・212: 芳香族（ベンゼン・置換・クメン法） =====
  {
    id:"cbeta_aromatic",
    name:"芳香族化合物・ベンゼンの反応",
    icon:"⬡",
    mode:"exam_chem",
    desc:"ベンゼンの置換反応、配向性、フェノールの製法",
    questions:[
      {stem:"ベンゼンが付加反応より置換反応を起こしやすいのは、次のどの性質によるか", reading:"（芳香族の特徴）", answer:"芳香族性（安定な共鳴構造をもつ）", wrong:["強い不飽和性","イオン結合性","金属結合性","強い塩基性"], extra:"ベンゼン環は安定で、二重結合をもつが付加より置換が起こりやすい"},
      {stem:"ベンゼンに鉄粉を触媒として塩素を作用させると生じる物質は", reading:"（ハロゲン化）", answer:"クロロベンゼン", wrong:["ベンゼンヘキサクロリド","塩化ベンジル","o-ジクロロベンゼン","塩化ベンゼンジアゾニウム"], extra:"鉄粉（塩化鉄(III)）を触媒とする置換反応。水素原子が塩素に置き換わる"},
      {stem:"ベンゼンに濃硝酸と濃硫酸の混合物（混酸）を加えて加熱すると生じる物質は", reading:"（ニトロ化）", answer:"ニトロベンゼン", wrong:["ベンゼンスルホン酸","フェノール","アニリン","安息香酸"], extra:"濃硫酸は触媒。−H が −NO₂ に置換される（ニトロ化）"},
      {stem:"ベンゼンを空気中で燃やすと多量のすすを出す主な理由は", reading:"（芳香族の燃焼）", answer:"炭素の含有率が高いため", wrong:["水素の含有率が高いため","酸素を多く含むため","窒素を含むため","分子量が小さいため"], extra:"C₆H₆ は炭素の割合が大きく、不完全燃焼で炭素（すす）を多く生じる"},
      {stem:"フェノールの工業的製法であるクメン法で、フェノールと同時に得られる物質は", reading:"（クメン法）", answer:"アセトン", wrong:["酢酸","ベンズアルデヒド","アセトアルデヒド","エタノール"], extra:"ベンゼン＋プロペン→クメン→酸化→分解でフェノールとアセトンが得られる"},
      {stem:"フェノール類を検出するのに用いる、青紫〜赤紫色に呈色する試薬は", reading:"（フェノールの検出）", answer:"塩化鉄(III)水溶液", wrong:["フェーリング液","アンモニア性硝酸銀水溶液","ヨウ素溶液","石灰水"], extra:"フェノール類は塩化鉄(III)で特有の青紫〜赤紫色を示す"},
      {stem:"o-キシレンやナフタレンを酸化バナジウム(V)触媒で酸化して得られる、加熱で脱水すると無水フタル酸になる物質は", reading:"（芳香族カルボン酸）", answer:"フタル酸", wrong:["テレフタル酸","安息香酸","サリチル酸","マレイン酸"], extra:"o位に2つの −COOH をもつフタル酸は加熱で分子内脱水し無水フタル酸になる"}
    ]
  },

  // ===== 化学213: アニリン・ジアゾ化・芳香族の分離 =====
  {
    id:"cbeta_aromatic_n",
    name:"アニリン・ジアゾ化・芳香族の分離",
    icon:"🧫",
    mode:"exam_chem",
    desc:"ジアゾ化・カップリング、酸・塩基による芳香族の分離",
    questions:[
      {stem:"ニトロベンゼンをスズ（または鉄）と塩酸で還元すると得られる物質は", reading:"（アニリンの製法）", answer:"アニリン", wrong:["フェノール","安息香酸","ベンゼンスルホン酸","ニトロトルエン"], extra:"−NO₂ が還元されて −NH₂ になる。得られたアニリン塩酸塩に塩基を加えアニリンを遊離させる"},
      {stem:"アニリンを塩酸に溶かし、低温（5℃以下）で亜硝酸ナトリウムを作用させる反応を何というか", reading:"（ジアゾ化）", answer:"ジアゾ化", wrong:["カップリング","ニトロ化","アセチル化","スルホン化"], extra:"塩化ベンゼンジアゾニウムが生じる。低温で行わないと分解してしまう"},
      {stem:"塩化ベンゼンジアゾニウムとナトリウムフェノキシドを反応させて橙〜赤色のアゾ染料を得る反応を何というか", reading:"（カップリング）", answer:"カップリング（ジアゾカップリング）", wrong:["ジアゾ化","エステル化","けん化","ニトロ化"], extra:"生じる p-ヒドロキシアゾベンゼンはアゾ基 −N=N− をもつ。アゾ染料の基本反応"},
      {stem:"トルエン・アニリン・フェノール・安息香酸のエーテル溶液に希塩酸を加えて振ると、塩をつくって水層に移るものは", reading:"（芳香族の分離）", answer:"アニリン（塩基性）", wrong:["フェノール","安息香酸","トルエン","ニトロベンゼン"], extra:"塩基性のアニリンは塩酸と塩（アニリン塩酸塩）をつくり水層へ移る"},
      {stem:"炭酸より強い酸で、炭酸水素ナトリウム水溶液を加えると塩をつくって水層に移る芳香族化合物は", reading:"（芳香族の分離）", answer:"安息香酸", wrong:["フェノール","アニリン","トルエン","ニトロベンゼン"], extra:"安息香酸（カルボン酸）は炭酸より強い酸。フェノールは炭酸より弱く NaHCO₃ とは反応しない"},
      {stem:"トルエンを過マンガン酸カリウムなどで酸化すると得られる芳香族カルボン酸は", reading:"（側鎖の酸化）", answer:"安息香酸", wrong:["フタル酸","サリチル酸","フェノール","ベンズアルデヒドで止まる"], extra:"ベンゼン環に結合したメチル基（側鎖）は酸化されて −COOH になる"}
    ]
  },

  // ===== 化学214: 油脂・セッケン =====
  {
    id:"cbeta_oil_soap",
    name:"油脂・セッケン・合成洗剤",
    icon:"🧼",
    mode:"exam_chem",
    desc:"油脂の構造・硬化油、脂肪酸の不飽和度、セッケンと合成洗剤",
    questions:[
      {stem:"油脂は、何と何がエステル結合した化合物か", reading:"（油脂）", answer:"高級脂肪酸3分子とグリセリン1分子", wrong:["高級脂肪酸1分子とグリセリン3分子","脂肪酸とエタノール","脂肪酸とグルコース","アミノ酸とグリセリン"], extra:"グリセリン（3価アルコール）の3つの −OH に高級脂肪酸がエステル結合している"},
      {stem:"不飽和脂肪酸を多く含む液体の油脂に水素を付加して固体にしたものを何というか", reading:"（硬化油）", answer:"硬化油", wrong:["乾性油","不乾性油","鉱油","半乾性油"], extra:"二重結合に水素が付加して飽和度が上がり固体になる。マーガリンなどの原料"},
      {stem:"オレイン酸・リノール酸・リノレン酸のうち、分子内の炭素間二重結合の数が最も多いものは", reading:"（脂肪酸の不飽和度）", answer:"リノレン酸（3個）", wrong:["オレイン酸（1個）","リノール酸（2個）","3つとも同じ","ステアリン酸"], extra:"オレイン酸1個・リノール酸2個・リノレン酸3個。DHAは6個ともっと多い"},
      {stem:"セッケンが水中でつくるミセルで、外側（水に接する側）を向くのは", reading:"（界面活性剤）", answer:"親水基", wrong:["疎水基","炭化水素基","カルボニル基","ベンゼン環"], extra:"水中では親水基（−COO⁻）が外側、疎水基（炭化水素鎖）が内側を向いて集まる"},
      {stem:"セッケンが動物性繊維（羊毛・絹）の洗浄に向かない理由は", reading:"（セッケンの性質）", answer:"水中で加水分解して弱塩基性を示し、繊維を傷めるため", wrong:["強酸性を示すため","硬水で泡立つため","水に溶けないため","中性で洗浄力がないため"], extra:"セッケンは弱塩基性。タンパク質でできた動物性繊維は塩基に弱い"},
      {stem:"硫酸アルキルナトリウムなどの合成洗剤が、セッケンと違って硬水でも使える理由は", reading:"（合成洗剤）", answer:"カルシウムイオンなどと難溶性の塩をつくりにくいため", wrong:["強酸性だから","水に溶けないから","泡立たないから","中性で反応しないので洗浄力がないから"], extra:"セッケンは硬水中の Ca²⁺・Mg²⁺ と難溶性の塩をつくり泡立たないが、合成洗剤はつくりにくい"}
    ]
  },

  // ===== 化学215・216: 糖類（単糖・多糖） =====
  {
    id:"cbeta_sugar",
    name:"糖類（グルコース・デンプン・セルロース）",
    icon:"🍬",
    mode:"exam_chem",
    desc:"単糖の還元性、デンプンとセルロースの違い",
    questions:[
      {stem:"グルコースの水溶液が銀鏡反応やフェーリング反応を示す（還元性をもつ）のは、鎖状構造がもつどの基によるか", reading:"（単糖の還元性）", answer:"ホルミル基（アルデヒド基）−CHO", wrong:["カルボキシ基 −COOH","ヒドロキシ基 −OH","カルボニル基のみ（ケトン）","エーテル結合"], extra:"グルコースは水溶液中でα型・鎖状・β型が平衡。鎖状の −CHO が還元性を示す"},
      {stem:"グルコースが水溶液中でとる、α型・鎖状・β型の関係は", reading:"（単糖の構造）", answer:"3つが平衡状態で混ざり合っている", wrong:["α型のみで存在する","β型に完全に変わる","加熱でしか変化しない","鎖状構造は存在しない"], extra:"環状のα型・β型と鎖状構造が一定の割合で平衡状態にある"},
      {stem:"光合成で二酸化炭素と水からグルコースが生成する反応で、同時に発生する気体は", reading:"（光合成）", answer:"酸素", wrong:["水素","窒素","メタン","一酸化炭素"], extra:"6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂"},
      {stem:"デンプンはα-グルコース、セルロースはβ-グルコースが多数縮合した多糖である。両者に共通する分子式は", reading:"（多糖類）", answer:"(C₆H₁₀O₅)ₙ", wrong:["(C₆H₁₂O₆)ₙ","(C₅H₁₀O₅)ₙ","(C₁₂H₂₂O₁₁)ₙ","(CH₂O)ₙ"], extra:"どちらもグルコースが縮合重合した (C₆H₁₀O₅)ₙ。構造の違いで性質が異なる"},
      {stem:"デンプンのうち、枝分かれのある構造をもつ成分を何というか", reading:"（デンプンの構造）", answer:"アミロペクチン", wrong:["アミロース","セルロース","グリコーゲン","マルトース"], extra:"直鎖状がアミロース、枝分かれがアミロペクチン。両者の混合物がデンプン"},
      {stem:"ヒトがデンプンは消化できてもセルロースを消化できない理由は", reading:"（酵素）", answer:"デンプンを分解するアミラーゼはもつが、セルロースを分解するセルラーゼをもたないため", wrong:["セルロースが水に溶けないため","セルロースが有毒なため","デンプンだけが糖でできているため","セルロースが消化管を通らないため"], extra:"ヒトはアミラーゼでデンプンを分解できるが、セルラーゼをもたない"},
      {stem:"デンプンにヨウ素溶液を加えると呈する色は（ヨウ素デンプン反応）", reading:"（デンプンの検出）", answer:"青紫色", wrong:["赤色","黄色","緑色","無色"], extra:"らせん構造にヨウ素が入り青紫色を示す。加熱すると色が消え、冷やすと戻る"}
    ]
  },

  // ===== 化学217・218: アミノ酸・タンパク質・核酸 =====
  {
    id:"cbeta_amino_protein",
    name:"アミノ酸・タンパク質・核酸",
    icon:"🧠",
    mode:"exam_chem",
    desc:"呈色反応・等電点、タンパク質の高次構造、DNAの塩基対",
    questions:[
      {stem:"アミノ酸やタンパク質に加えると紫色に呈色する、その検出に使われる反応は", reading:"（呈色反応）", answer:"ニンヒドリン反応", wrong:["キサントプロテイン反応","ビウレット反応","銀鏡反応","ヨウ素デンプン反応"], extra:"ニンヒドリン反応はアミノ基の検出。加熱すると赤紫〜青紫色を示す"},
      {stem:"ベンゼン環をもつアミノ酸を含むタンパク質に濃硝酸を加えて加熱すると黄色になる反応を何というか", reading:"（呈色反応）", answer:"キサントプロテイン反応", wrong:["ニンヒドリン反応","ビウレット反応","フェーリング反応","硫黄の検出反応"], extra:"チロシンなどベンゼン環をもつアミノ酸で起こる。アンモニア水を加えると橙黄色になる"},
      {stem:"ペプチド結合を2個以上もつタンパク質に、水酸化ナトリウムと硫酸銅(II)を加えると赤紫色になる反応を何というか", reading:"（呈色反応）", answer:"ビウレット反応", wrong:["ニンヒドリン反応","キサントプロテイン反応","銀鏡反応","テルミット反応"], extra:"ペプチド結合と銅(II)イオンが錯体をつくり赤紫色になる"},
      {stem:"α-アミノ酸のうち、不斉炭素原子をもたず鏡像異性体が存在しないものは", reading:"（アミノ酸）", answer:"グリシン", wrong:["アラニン","システイン","チロシン","グルタミン酸"], extra:"グリシンは側鎖が水素で、中心炭素に同じ基が2つあるため不斉炭素をもたない"},
      {stem:"システインがもつ −SH（チオール基）が酸化されてできる、タンパク質の立体構造を安定化する結合は", reading:"（タンパク質の構造）", answer:"ジスルフィド結合（−S−S−）", wrong:["水素結合","エステル結合","ペプチド結合","イオン結合"], extra:"2つの −SH が酸化的に結びつく。毛髪のパーマなどにも関係する"},
      {stem:"タンパク質のα-ヘリックスやβ-シートといった二次構造を主に形成する結合は", reading:"（タンパク質の高次構造）", answer:"水素結合", wrong:["ジスルフィド結合","イオン結合","共有結合（ペプチド結合以外）","配位結合"], extra:"ペプチド結合部分どうしの水素結合でらせん（α-ヘリックス）やシート構造ができる"},
      {stem:"DNAの二重らせんで、塩基が水素結合をつくる正しい組合せは", reading:"（DNAの塩基対）", answer:"A−T と G−C", wrong:["A−G と C−T","A−C と G−T","A−U と G−C","T−C と A−G"], extra:"アデニンとチミン、グアニンとシトシンが相補的に対をつくる。RNAではTの代わりにU"},
      {stem:"核酸（DNA・RNA）の基本単位で、糖・塩基・リン酸が結合したものを何というか", reading:"（核酸）", answer:"ヌクレオチド", wrong:["アミノ酸","モノマー糖","ヌクレオシドのみ","ペプチド"], extra:"ヌクレオチドが多数連なった高分子が核酸。DNAの糖はデオキシリボース、RNAはリボース"}
    ]
  },

  // ===== 化学1E21: 熱化学（結合エネルギー・格子エネルギー・平衡・溶解熱） =====
  {
    id:"cbeta_e_thermo",
    name:"熱化学・結合エネルギー・平衡移動",
    icon:"🔥",
    mode:"exam_chem",
    desc:"結合/格子エネルギー、反応エンタルピー、ルシャトリエの原理",
    questions:[
      {stem:"気体分子中の共有結合 1 mol を切断するのに必要なエネルギーを何というか", reading:"（結合エネルギー）", answer:"結合エネルギー", wrong:["格子エネルギー","イオン化エネルギー","電子親和力","活性化エネルギー","昇華熱"], extra:"結合1molの切断に必要なエネルギー。切断は吸熱、生成は発熱"},
      {stem:"反応エンタルピーΔHを結合エネルギーから求める正しい式は", reading:"（結合エネルギーとΔH）", answer:"ΔH＝（切れる結合の結合エネルギーの和）−（できる結合の結合エネルギーの和）", wrong:["ΔH＝（できる結合の和）−（切れる結合の和）","ΔH＝両者の和","ΔH＝両者の積","ΔH＝生成物の結合エネルギーのみ"], extra:"結合を切るのに吸収、つくるときに放出するため。エチレンの水素付加などで使う"},
      {stem:"イオン結晶 1 mol を、ばらばらの気体イオンにするのに必要なエネルギーを何というか", reading:"（格子エネルギー）", answer:"格子エネルギー", wrong:["結合エネルギー","水和エネルギー","イオン化エネルギー","電子親和力","溶解熱"], extra:"NaCl(固)→Na⁺(気)+Cl⁻(気) に必要なエネルギー。直接測れずヘスの法則で求める"},
      {stem:"NaClの格子エネルギーを、昇華熱・結合エネルギー・イオン化エネルギー・電子親和力・生成熱を組み合わせて求めるときに使う法則は", reading:"（ボルン・ハーバーサイクル）", answer:"ヘスの法則", wrong:["ルシャトリエの原理","ファントホッフの法則","ヘンリーの法則","質量作用の法則","アボガドロの法則"], extra:"エネルギー図（ボルン・ハーバーサイクル）を描き、経路によらない総熱量から求める"},
      {stem:"ナトリウム原子 Na(気) から電子1個を取り去って Na⁺(気) にするのに必要なエネルギーを何というか", reading:"（イオン化エネルギー）", answer:"イオン化エネルギー", wrong:["電子親和力","格子エネルギー","昇華熱","結合エネルギー"], extra:"電子親和力は逆に、原子が電子1個を受け取るときに放出するエネルギー"},
      {stem:"可逆反応 aA＋bB ⇄ cC で、温度を上げると生成物Cの割合が減少した。この正反応はどちらか", reading:"（ルシャトリエの原理）", answer:"発熱反応（ΔH＜0）", wrong:["吸熱反応（ΔH＞0）","熱の出入りがない反応","温度と平衡は無関係","判断できない"], extra:"温度を上げると吸熱方向（逆反応）へ平衡が移動したので、正反応は発熱"},
      {stem:"気体反応 aA＋bB ⇄ cC で、圧力を上げると生成物Cの割合が増加した。係数の関係として正しいものは", reading:"（ルシャトリエの原理）", answer:"a＋b ＞ c", wrong:["a＋b ＝ c","a＋b ＜ c","a ＝ c","判断できない"], extra:"加圧すると気体分子数が減る方向へ移動する。正反応で分子数が減るので a+b＞c"},
      {stem:"硝酸アンモニウムを水に溶かすと ΔH＝＋26 kJ（吸熱）である。溶かしたとき水溶液の温度はどうなるか", reading:"（溶解エンタルピー）", answer:"下がる", wrong:["上がる","変わらない","一度上がってから下がる","沸騰する"], extra:"吸熱溶解なので周囲から熱を奪い温度が下がる。瞬間冷却パックに利用される"},
      {stem:"断熱容器中で発生した熱 q〔J〕による溶液の温度上昇ΔTを、溶液の質量m〔g〕・比熱c〔J/(g・K)〕で表すと", reading:"（熱量計算）", answer:"ΔT＝q／(mc)", wrong:["ΔT＝qmc","ΔT＝mc／q","ΔT＝q／(m＋c)","ΔT＝qc／m"], extra:"q＝mcΔT の変形。溶解熱・中和熱の実験計算の基本式"}
    ]
  },

  // ===== 化学1E22: 鉛蓄電池・二次電池 =====
  {
    id:"cbeta_e_leadbattery",
    name:"鉛蓄電池・二次電池",
    icon:"🔋",
    mode:"exam_chem",
    desc:"鉛蓄電池の放電・充電、電気量の計算、二次電池の分類",
    questions:[
      {stem:"鉛蓄電池の負極・正極・電解液の正しい組合せは", reading:"（鉛蓄電池）", answer:"負極＝Pb、正極＝PbO₂、電解液＝希硫酸", wrong:["負極＝PbO₂、正極＝Pb、電解液＝希硫酸","負極＝Pb、正極＝PbO₂、電解液＝希塩酸","負極＝Zn、正極＝Cu、電解液＝希硫酸","負極＝Pb、正極＝PbSO₄、電解液＝濃硫酸"], extra:"Pb｜H₂SO₄aq｜PbO₂。自動車のバッテリーに使われる代表的な二次電池"},
      {stem:"鉛蓄電池の放電時、正極の PbO₂ はどう変化するか", reading:"（放電の正極）", answer:"還元されて PbSO₄ が極板に付着する", wrong:["酸化されて PbSO₄ になる","還元されて Pb になる","酸化されて PbO₄ になる","変化しない"], extra:"正極: PbO₂ + 4H⁺ + SO₄²⁻ + 2e⁻ → PbSO₄ + 2H₂O。Pbの酸化数は+4→+2に減少（還元）"},
      {stem:"鉛蓄電池の放電時、負極の Pb はどう変化するか", reading:"（放電の負極）", answer:"酸化されて PbSO₄ が極板に付着する", wrong:["還元されて PbSO₄ になる","酸化されて PbO₂ になる","溶けて Pb²⁺ として電解液中に出る","変化しない"], extra:"負極: Pb + SO₄²⁻ → PbSO₄ + 2e⁻。両極とも放電でPbSO₄が付着し質量が増える"},
      {stem:"鉛蓄電池を放電させると、電解液の希硫酸の濃度はどうなるか", reading:"（電解液の変化）", answer:"低くなる（薄くなる）", wrong:["高くなる","変わらない","一度高くなってから下がる","ゼロになる"], extra:"放電で H₂SO₄ が消費され H₂O が生成するため濃度が下がる。充電すると元に戻る"},
      {stem:"0.200 A の一定電流を 4825 秒間流したときに流れる電気量は（ファラデー定数 9.65×10⁴ C/mol）", reading:"（電気量の計算）", answer:"965 C（電子 0.0100 mol）", wrong:["965 C（電子 0.100 mol）","9650 C（電子 0.100 mol）","96.5 C（電子 0.00100 mol）","4825 C（電子 0.0500 mol）"], extra:"Q＝It＝0.200×4825＝965 C。965÷96500＝0.0100 mol の電子に相当"},
      {stem:"鉛蓄電池を充電すると、負極（Pb極）の質量はどうなるか", reading:"（充電）", answer:"PbSO₄ が Pb に戻り、SO₄ の分だけ減少する", wrong:["PbSO₄ が増えて増加する","PbO₂ が生成して増加する","変化しない","Pb が溶け出してゼロに近づく"], extra:"充電は放電の逆反応。PbSO₄ + 2e⁻ → Pb + SO₄²⁻ で極板から SO₄ 分の質量が減る"},
      {stem:"鉛蓄電池のように、充電して繰り返し使える電池を何というか", reading:"（電池の分類）", answer:"二次電池（蓄電池）", wrong:["一次電池","燃料電池","太陽電池","乾電池"], extra:"充電可能＝二次電池。使い切り＝一次電池"},
      {stem:"次のうち二次電池はどれか", reading:"（電池の分類）", answer:"リチウムイオン電池・ニッケル水素電池", wrong:["アルカリマンガン乾電池","ダニエル電池","マンガン乾電池","空気亜鉛電池"], extra:"リチウムイオン電池（スマホ）・ニッケル水素電池・鉛蓄電池は二次電池。乾電池類は一次電池"}
    ]
  },

  // ===== 化学1E23: 水溶液のpH・溶解度・束一的性質 =====
  {
    id:"cbeta_e_ph_solubility",
    name:"pH・電離平衡・溶解度",
    icon:"💧",
    mode:"exam_chem",
    desc:"極希薄溶液のpH、塩の加水分解、緩衝液、ヘンリーの法則",
    questions:[
      {stem:"1.0×10⁻⁷ mol/L という極めて薄い塩酸のpHはどうなるか", reading:"（極希薄溶液のpH）", answer:"7よりわずかに小さい（約6.8）", wrong:["ちょうど7","ちょうど8","7よりわずかに大きい","4になる"], extra:"水の電離による H⁺ が無視できないため、pH=7を超えることはなく7弱になる"},
      {stem:"酸をどれだけ水で薄めても、水溶液のpHが7を超えて塩基性にならない理由は", reading:"（水の電離）", answer:"水自身の電離で H⁺ が supplied されるため", wrong:["酸が完全には電離しないため","水が酸性物質だから","塩基が生成するため","蒸発するため"], extra:"薄い酸では水の電離（Kw=[H⁺][OH⁻]=10⁻¹⁴）を考慮して[H⁺]を求める"},
      {stem:"0.10 mol/L 塩酸 10 mL に 0.10 mol/L アンモニア水 20 mL を加えた水溶液に含まれる主な成分は", reading:"（中和と緩衝液）", answer:"NH₄⁺（塩）と余った NH₃ が同量ずつ", wrong:["HCl だけが残る","NH₃ だけが残る","NH₄⁺ だけが残る","H₂O のみ"], extra:"HCl 1.0mmol と NH₃ 2.0mmol → NH₄Cl 1.0mmol + NH₃ 1.0mmol の緩衝液（弱塩基性）になる"},
      {stem:"弱塩基とその塩（例: NH₃ と NH₄Cl）が共存し、少量の酸や塩基を加えてもpHがほぼ変わらない溶液を何というか", reading:"（緩衝液）", answer:"緩衝液", wrong:["飽和溶液","標準溶液","コロイド溶液","過飽和溶液"], extra:"弱酸+その塩、弱塩基+その塩の混合溶液は緩衝作用を示す"},
      {stem:"酢酸ナトリウム水溶液が塩基性を示す理由は", reading:"（塩の加水分解）", answer:"酢酸イオンが加水分解して OH⁻ を生じるため", wrong:["ナトリウムイオンが OH⁻ を放出するため","酢酸が強酸だから","完全に電離しないため","CO₂ を吸収するため"], extra:"CH₃COO⁻ + H₂O ⇄ CH₃COOH + OH⁻。弱酸+強塩基の塩は塩基性を示す"},
      {stem:"一定温度で一定量の液体に溶ける気体の物質量は圧力に比例する。この法則を何というか", reading:"（気体の溶解度）", answer:"ヘンリーの法則", wrong:["ヘスの法則","ラウールの法則","ボイルの法則","ファントホッフの法則"], extra:"溶ける体積は（その圧力下では）一定、物質量は圧力に比例する点に注意"},
      {stem:"同じ質量モル濃度の塩化カルシウム水溶液と塩化ナトリウム水溶液では、どちらの沸点が高いか", reading:"（沸点上昇と電離）", answer:"塩化カルシウム水溶液（粒子数が3倍相当のため）", wrong:["塩化ナトリウム水溶液","同じ温度で沸騰する","どちらも100℃で沸騰する","濃度によらず塩化ナトリウムが高い"], extra:"CaCl₂→Ca²⁺+2Cl⁻で3粒子、NaCl→2粒子。沸点上昇は溶質粒子の総数に比例する"},
      {stem:"同じ質量のグルコース（分子量180）とスクロース（分子量342）を同量の水に溶かしたとき、凝固点が低いのは", reading:"（凝固点降下）", answer:"グルコース水溶液（分子量が小さく粒子数が多い）", wrong:["スクロース水溶液","同じ温度で凝固する","どちらも0℃で凝固する","高分子ほど凝固点が低い"], extra:"同質量なら分子量の小さい方が物質量（粒子数）が多く、凝固点降下が大きい"},
      {stem:"デンプン水溶液の分子量を求めるのに適した測定と法則は", reading:"（分子量測定）", answer:"浸透圧を測り、ファントホッフの法則を使う", wrong:["沸点上昇を測り、ヘンリーの法則を使う","チンダル現象の強さを測る","電気泳動の速さを測る","蒸気圧を測り、ボイルの法則を使う"], extra:"高分子は凝固点降下・沸点上昇が小さすぎるため、感度の高い浸透圧（π=CRT）を用いる"},
      {stem:"チンダル現象が起こる理由として正しいものは", reading:"（コロイド）", answer:"コロイド粒子が光を散乱するため", wrong:["コロイド粒子が光を吸収するため","コロイド粒子が発光するため","溶媒が光を屈折させるだけのため","粒子が帯電しているため"], extra:"光の通路が輝いて見えるのは散乱による。「吸収するため」という説明は誤り"}
    ]
  },

  // ===== 化学1E24: 反応速度・理想気体・水上置換 =====
  {
    id:"cbeta_e_kinetics_gas",
    name:"反応速度・理想気体・気体の捕集",
    icon:"⏱️",
    mode:"exam_chem",
    desc:"触媒・活性化エネルギー・水上置換の分圧・理想気体の条件",
    questions:[
      {stem:"過酸化水素水に酸化マンガン(IV)を加えると酸素が発生する。このときの酸化マンガン(IV)のはたらきは", reading:"（触媒）", answer:"触媒", wrong:["酸化剤","還元剤","指示薬","中和剤"], extra:"2H₂O₂ → 2H₂O + O₂。MnO₂自身は変化せず反応を速くする"},
      {stem:"水上置換で捕集した気体の圧力について、捕集気体そのものの分圧を表す式は（大気圧P₀、水の蒸気圧P）", reading:"（水上置換と分圧）", answer:"P₀ − P", wrong:["P₀ + P","P₀ × P","P − P₀","P₀ ÷ P"], extra:"メスシリンダー内には水蒸気が混ざるため、目的気体の分圧は大気圧から蒸気圧を引く"},
      {stem:"水上置換で捕集した気体の物質量nを表す式は（大気圧P₀、水の蒸気圧P、体積V、温度T、気体定数R）", reading:"（気体の状態方程式）", answer:"n ＝ (P₀−P)V / RT", wrong:["n ＝ P₀V / RT","n ＝ PV / RT","n ＝ (P₀+P)V / RT","n ＝ (P−P₀)V / RT"], extra:"分圧 P₀−P を状態方程式 PV=nRT に代入する。実験でよく問われる形"},
      {stem:"理想気体で無視しているものの正しい組合せは", reading:"（理想気体）", answer:"分子自身の体積と分子間力", wrong:["分子の質量と体積","分子の質量と分子間力","分子の運動エネルギー","分子の数"], extra:"質量は無視していない（質量を無視すると密度も物質量もなくなる）"},
      {stem:"実在気体が理想気体に近づく条件は", reading:"（実在気体）", answer:"高温・低圧", wrong:["低温・高圧","低温・低圧","高温・高圧","温度・圧力によらない"], extra:"高温では分子間力の影響が、低圧では分子体積の影響が小さくなる"},
      {stem:"理想気体について常に成立する法則は", reading:"（理想気体）", answer:"ボイル・シャルルの法則", wrong:["ヘンリーの法則","ヘスの法則","ラウールの法則","ルシャトリエの原理"], extra:"理想気体は定義上 PV=nRT（ボイル・シャルル）が常に成立する"},
      {stem:"触媒を加えると反応が速くなる理由は", reading:"（触媒と活性化エネルギー）", answer:"活性化エネルギーの小さい別の反応経路をつくるため", wrong:["反応エンタルピーを大きくするため","温度を上げるため","濃度を上げるため","平衡を生成物側に移動させるため"], extra:"触媒は活性化エネルギーを下げるが、反応エンタルピーΔHと平衡定数は変えない"},
      {stem:"過酸化水素の分解が進行すると、分解速度vはどうなるか", reading:"（反応速度と濃度）", answer:"[H₂O₂]が減るため小さくなり、すべて分解された時点で0になる", wrong:["一定のまま変わらない","だんだん大きくなる","平衡状態になり一定値を保つ","温度が上がって速くなる"], extra:"v=k[H₂O₂]。濃度の減少とともに速度も減少し、濃度0で速度0"},
      {stem:"反応速度定数kが大きくなる操作は", reading:"（速度定数）", answer:"温度を上げる（または触媒を加える）", wrong:["濃度を上げる","圧力を上げる","体積を減らす","撹拌する"], extra:"kは温度と触媒で変わる。濃度を上げると速度vは増すがkは変わらない"}
    ]
  },

  // ===== 化学1E25: 状態図・超臨界流体 =====
  {
    id:"cbeta_e_phase",
    name:"状態図・三重点・超臨界流体",
    icon:"🧊",
    mode:"exam_chem",
    desc:"二酸化炭素の状態図、三重点・臨界点、状態変化のグラフ",
    questions:[
      {stem:"状態図で、固体・液体・気体の3つの状態が共存できる点を何というか", reading:"（状態図）", answer:"三重点", wrong:["臨界点","融点","沸点","共晶点"], extra:"CO₂の三重点は約−57℃・5.2×10⁵Pa。これ未満の圧力では液体は存在できない"},
      {stem:"気体と液体の境界線（蒸気圧曲線）の終わりの点Yを何というか。またそれ以上の温度・圧力では何が起こるか", reading:"（臨界点）", answer:"臨界点。気体と液体の区別がつかなくなる", wrong:["三重点。すべて固体になる","沸点。激しく沸騰し続ける","融点。すべて融解する","臨界点。分解反応が起こる"], extra:"臨界点（CO₂は31℃・7.4×10⁶Pa）を超えた状態が超臨界流体"},
      {stem:"臨界点を超えた温度・圧力にある、気体と液体の性質をあわせもつ状態を何というか", reading:"（超臨界流体）", answer:"超臨界流体", wrong:["過冷却液体","飽和蒸気","プラズマ","アモルファス"], extra:"超臨界CO₂はコーヒーのカフェイン抽出などに利用される"},
      {stem:"1.013×10⁵ Pa（大気圧）でドライアイスを放置すると起こる状態変化は", reading:"（昇華）", answer:"融けずに直接気体になる（昇華）", wrong:["融けて液体になってから蒸発する","液体のまま安定に存在する","凝縮して液体になる","変化しない"], extra:"大気圧はCO₂の三重点の圧力（5.2×10⁵Pa）より低いので液体を経ずに昇華する"},
      {stem:"密閉容器内の気体CO₂を圧力一定のまま冷却して固体まで変化させたとき、体積変化のグラフの特徴は", reading:"（定圧冷却）", answer:"温度に比例して縮み、凝縮（凝固）する温度で不連続に大きく減少する", wrong:["常に一定の割合で直線的に減り続ける","温度が下がるほど膨張する","状態変化しても体積は変化しない","冷却の途中で一度増加する"], extra:"気体はシャルルの法則で縮み、状態変化の温度で密度が急増（体積が急減）する"},
      {stem:"水の状態図がCO₂と異なる大きな特徴は", reading:"（水の状態図）", answer:"融解曲線が左（負）に傾き、加圧すると融点が下がる", wrong:["融解曲線が右に傾く","三重点が存在しない","臨界点が存在しない","昇華しない"], extra:"氷は水より密度が小さいため、加圧すると融ける（スケートが滑る一因）"}
    ]
  },

  // ===== 化学2E11: 銀の反応・金属イオンの系統分離・金属の推定 =====
  {
    id:"cbeta_e_silver_separation",
    name:"銀の反応・系統分離・金属の推定",
    icon:"🥈",
    mode:"exam_chem",
    desc:"銀アンモニア錯イオン・銀鏡反応、Fe/Cu/Mnの分離、金属の識別",
    questions:[
      {stem:"硝酸銀水溶液に少量のアンモニア水を滴下したときに生じる褐色沈殿は", reading:"（銀の沈殿）", answer:"酸化銀 Ag₂O", wrong:["水酸化銀 AgOH（白色で安定）","塩化銀 AgCl","硫化銀 Ag₂S","クロム酸銀 Ag₂CrO₄"], extra:"AgOHは不安定で、ただちに褐色のAg₂Oになる"},
      {stem:"酸化銀の沈殿に過剰のアンモニア水を加えると溶けて生じる錯イオンとその形は", reading:"（錯イオン）", answer:"[Ag(NH₃)₂]⁺・直線形", wrong:["[Ag(NH₃)₄]²⁺・正四面体形","[Ag(NH₃)₂]⁺・正方形","[Ag(NH₃)₄]⁺・正八面体形","[Ag(NH₃)₆]³⁺・正八面体形"], extra:"配位数2の錯イオンは直線形。ジアンミン銀(I)イオン"},
      {stem:"アンモニア性硝酸銀水溶液にホルムアルデヒドを加えて温めると、試験管の内壁に銀が析出する反応を何というか", reading:"（銀鏡反応）", answer:"銀鏡反応", wrong:["フェーリング反応","ビウレット反応","テルミット反応","ヨードホルム反応"], extra:"アルデヒドの還元性でAg⁺が還元され銀鏡ができる"},
      {stem:"ホルムアルデヒドの代わりに銀鏡反応を起こせるカルボン酸は", reading:"（還元性のある酸）", answer:"ギ酸", wrong:["酢酸","塩酸","硝酸","酒石酸"], extra:"ギ酸 HCOOH は分子内にホルミル基（-CHO）をもつため還元性を示す"},
      {stem:"Fe³⁺・Cu²⁺・Mn²⁺ を含む水溶液に、酸性条件で硫化水素を通じたとき沈殿するのは", reading:"（系統分離）", answer:"CuS（黒色）のみ", wrong:["FeS のみ","MnS のみ","3つとも沈殿する","何も沈殿しない"], extra:"酸性でも硫化物が沈殿するのはイオン化傾向の小さい Cu・Pb・Ag など"},
      {stem:"硫化水素を通じたあとの溶液を煮沸してから硝酸を加える理由は", reading:"（系統分離の操作）", answer:"H₂Sを追い出し、還元された Fe²⁺ を Fe³⁺ に酸化し直すため", wrong:["溶液を濃縮するため","Cuを完全に沈殿させるため","アンモニアを除くため","Mnを酸化して沈殿させるため"], extra:"H₂SでFe³⁺はFe²⁺に還元されている。硝酸で再酸化してからNH₃でFe(OH)₃として沈殿させる"},
      {stem:"Fe³⁺・Mn²⁺ を含む溶液に塩化アンモニウムとアンモニア水を十分に加えたとき沈殿するのは", reading:"（系統分離）", answer:"水酸化鉄(III)（赤褐色）のみ", wrong:["Mn(OH)₂ のみ","両方沈殿する","何も沈殿しない","MnO₂ が沈殿する"], extra:"Mn²⁺はNH₄Cl緩衝下ではOH⁻濃度が低く沈殿しない。塩基性でH₂Sを通じるとMnS（淡赤色）が沈殿"},
      {stem:"常温の水とは反応しないが、沸騰しない程度の熱水とは反応して水素を発生する金属は", reading:"（金属の推定）", answer:"マグネシウム Mg", wrong:["ナトリウム Na","亜鉛 Zn","銅 Cu","銀 Ag","鉄 Fe"], extra:"Naは常温の水と反応、Mgは熱水、Zn・Feは高温の水蒸気と反応する"},
      {stem:"塩酸にも水酸化ナトリウム水溶液にも水素を発生して溶ける金属の組は", reading:"（両性金属）", answer:"亜鉛 Zn・アルミニウム Al", wrong:["鉄 Fe・銅 Cu","銀 Ag・金 Au","マグネシウム Mg・カルシウム Ca","ニッケル Ni・鉄 Fe"], extra:"両性金属（Al・Zn・Sn・Pb）は強酸にも強塩基にも溶ける"},
      {stem:"金属のうち電気伝導率が最も大きいものは", reading:"（金属の性質）", answer:"銀 Ag", wrong:["銅 Cu","金 Au","アルミニウム Al","鉄 Fe"], extra:"電気伝導率は Ag＞Cu＞Au＞Al の順。銀が全金属中最大"},
      {stem:"希硝酸には溶けるが、濃硝酸には表面に緻密な酸化被膜をつくって溶けにくくなる金属の組は", reading:"（不動態）", answer:"鉄 Fe・アルミニウム Al", wrong:["銅 Cu・銀 Ag","亜鉛 Zn・マグネシウム Mg","金 Au・白金 Pt","鉛 Pb・スズ Sn"], extra:"Fe・Ni・Al は濃硝酸で不動態となる。「手にあるニッケル（Fe・Ni・Al）」と覚える"},
      {stem:"塩酸に溶けて淡緑色の水溶液になる金属は", reading:"（イオンの色）", answer:"鉄 Fe（Fe²⁺ が淡緑色）", wrong:["銅 Cu","亜鉛 Zn","アルミニウム Al","マグネシウム Mg"], extra:"Fe + 2HCl → FeCl₂ + H₂。Fe²⁺は淡緑色、Fe³⁺は黄褐色"}
    ]
  },

  // ===== 化学2E12: 溶解度積・無機各論の正誤 =====
  {
    id:"cbeta_e_ksp_inorganic",
    name:"溶解度積・無機物質の性質",
    icon:"⚖️",
    mode:"exam_chem",
    desc:"溶解度積と共通イオン効果、アルカリ金属・金属の製法・光触媒",
    questions:[
      {stem:"難溶性塩 PbF₂ の飽和水溶液で成り立つ溶解度積 Ksp の正しい式は", reading:"（溶解度積）", answer:"Ksp ＝ [Pb²⁺][F⁻]²", wrong:["Ksp ＝ [Pb²⁺][F⁻]","Ksp ＝ [Pb²⁺]²[F⁻]","Ksp ＝ [Pb²⁺]＋[F⁻]","Ksp ＝ [PbF₂]"], extra:"PbF₂ ⇄ Pb²⁺ + 2F⁻。係数が濃度の指数になる"},
      {stem:"PbF₂ の水への溶解度を s〔mol/L〕とすると、Ksp を s で表した式は", reading:"（溶解度積の計算）", answer:"Ksp ＝ 4s³", wrong:["Ksp ＝ s²","Ksp ＝ 2s²","Ksp ＝ s³","Ksp ＝ 27s⁴"], extra:"[Pb²⁺]=s、[F⁻]=2s なので Ksp=s×(2s)²=4s³"},
      {stem:"PbF₂ を純水に溶かす場合と、フッ化ナトリウム水溶液に溶かす場合、溶解度が大きいのは", reading:"（共通イオン効果）", answer:"純水（NaF水溶液では共通イオン効果で溶けにくくなる）", wrong:["NaF水溶液","どちらも同じ","NaF水溶液のほうが多く溶ける","濃度によらず同じ"], extra:"F⁻が共通イオンとして存在すると平衡が左に偏り、溶解度が下がる"},
      {stem:"アルカリ金属の単体の融点について正しいものは", reading:"（アルカリ金属）", answer:"ナトリウムはカリウムより融点が高い", wrong:["カリウムのほうが融点が高い","融点はすべて同じ","原子番号が大きいほど融点が高い","どちらも1000℃以上"], extra:"融点は Li＞Na＞K＞Rb＞Cs。原子が大きいほど金属結合が弱く融点が低い"},
      {stem:"炭酸水素カルシウム水溶液を加熱すると起こる変化は", reading:"（鍾乳洞の化学）", answer:"CO₂を放出して炭酸カルシウムが析出する", wrong:["水素が発生する","酸化カルシウムが析出する","変化しない","塩化カルシウムになる"], extra:"Ca(HCO₃)₂ → CaCO₃↓ + H₂O + CO₂。鍾乳洞の石筍・鍾乳石ができる反応"},
      {stem:"酢酸カルシウムを乾留（空気を断って加熱）すると得られる有機化合物は", reading:"（乾留）", answer:"アセトン", wrong:["アセトアルデヒド","エタノール","メタン","ホルムアルデヒド"], extra:"(CH₃COO)₂Ca → CaCO₃ + CH₃COCH₃。アセトンの製法のひとつ"},
      {stem:"炭化カルシウム（カーバイド）に水を加えると発生する気体は", reading:"（カーバイド）", answer:"アセチレン", wrong:["メタン","エチレン","水素","一酸化炭素"], extra:"CaC₂ + 2H₂O → Ca(OH)₂ + C₂H₂。アセチレンの実験室的製法"},
      {stem:"壁面コーティングなどに使われ、紫外線が当たると付着した有機物の汚れを分解する物質は", reading:"（光触媒）", answer:"酸化チタン(IV) TiO₂", wrong:["酸化亜鉛 ZnO","酸化アルミニウム","シリカゲル","酸化バナジウム(V)"], extra:"TiO₂は光触媒。セルフクリーニング・防汚・抗菌タイルなどに利用"},
      {stem:"鋼板の表面をスズでめっきしたものをブリキという。ブリキの特徴として正しいものは", reading:"（めっき）", answer:"表面に傷がつくと内側の鉄が先に腐食されやすい", wrong:["傷がついてもスズが先に溶けて鉄を守る","亜鉛めっきより傷に強い","鉄よりイオン化傾向の大きい金属で覆っている","水中でも絶対にさびない"], extra:"SnはFeよりイオン化傾向が小さいため、傷がつくとFeが先に酸化される。トタン（Zn）は逆に亜鉛が先に溶けて守る"},
      {stem:"銅を二酸化炭素を含む湿った空気中に放置すると生じる緑色のさびを何というか", reading:"（銅のさび）", answer:"緑青（ろくしょう）", wrong:["青銅","黒さび","赤さび","不動態"], extra:"緑青は塩基性炭酸銅が主成分。鎌倉の大仏の色"},
      {stem:"二クロム酸カリウム水溶液に水酸化カリウム水溶液を加えたときの色の変化は", reading:"（クロム酸の平衡）", answer:"赤橙色から黄色に変化する", wrong:["黄色から赤橙色に変化する","無色になる","緑色になる","変化しない"], extra:"塩基性で Cr₂O₇²⁻（赤橙）→ CrO₄²⁻（黄）。酸を加えると逆に戻る"},
      {stem:"塩化パラジウム(II)と塩化銅(II)を触媒にエチレンを空気酸化して工業的にアセトアルデヒドを得る方法を何というか", reading:"（ヘキスト・ワッカー法）", answer:"ヘキスト・ワッカー法", wrong:["クメン法","オストワルト法","接触法","ソルベー法"], extra:"かつての硫酸水銀法に代わるアセトアルデヒドの工業的製法"}
    ]
  },

  // ===== 化学2E13: 気体の製法まとめ・ハロゲン・脂肪族の正誤 =====
  {
    id:"cbeta_e_gasmaking",
    name:"気体の製法まとめ・ハロゲン・脂肪族",
    icon:"🧯",
    mode:"exam_chem",
    desc:"実験室での気体の製法・性質、ハロゲン、メタン・異性体",
    questions:[
      {stem:"塩化ナトリウムに濃硫酸を加えて加熱すると発生する気体は", reading:"（気体の製法）", answer:"塩化水素 HCl", wrong:["塩素 Cl₂","二酸化硫黄 SO₂","水素 H₂","次亜塩素酸 HClO"], extra:"NaCl + H₂SO₄ → NaHSO₄ + HCl。揮発性の酸の塩+不揮発性の酸"},
      {stem:"硫化鉄(II)に希硫酸を加えると発生する、腐卵臭のある気体は", reading:"（気体の製法）", answer:"硫化水素 H₂S", wrong:["二酸化硫黄 SO₂","硫黄蒸気","水素 H₂","アンモニア NH₃"], extra:"FeS + H₂SO₄ → FeSO₄ + H₂S。無色・腐卵臭・有毒・還元性"},
      {stem:"アンモニアと塩化水素の気体どうしが触れ合うと観察される現象は", reading:"（気体の検出）", answer:"白煙（塩化アンモニウムの微粒子）を生じる", wrong:["赤褐色の気体になる","青紫色に発色する","爆発する","何も起こらない"], extra:"NH₃ + HCl → NH₄Cl。互いの検出に利用される"},
      {stem:"一酸化窒素 NO の性質として正しいものは", reading:"（窒素酸化物）", answer:"無色で水に溶けにくく、空気に触れると赤褐色の NO₂ になる", wrong:["赤褐色で刺激臭がある","水によく溶けて酸性を示す","塩基性の気体である","黄緑色で漂白作用がある"], extra:"NOは無色・水上置換で捕集。2NO + O₂ → 2NO₂（赤褐色）"},
      {stem:"酸化マンガン(IV)に濃塩酸を加えて加熱すると発生する黄緑色の気体は", reading:"（気体の製法）", answer:"塩素 Cl₂", wrong:["塩化水素 HCl","酸素 O₂","二酸化窒素 NO₂","フッ素 F₂"], extra:"MnO₂ + 4HCl → MnCl₂ + 2H₂O + Cl₂。下方置換で捕集"},
      {stem:"塩素の検出に使う、湿ったヨウ化カリウムデンプン紙の変化は", reading:"（塩素の検出）", answer:"青紫色になる", wrong:["赤色になる","白くなる","変化しない","黄色になる"], extra:"Cl₂がI⁻を酸化してI₂が遊離し、ヨウ素デンプン反応で青紫色を示す"},
      {stem:"塩素を臭化カリウム水溶液に通じると起こる変化は", reading:"（ハロゲンの酸化力）", answer:"臭素が遊離して溶液が褐色になる", wrong:["変化は起こらない","フッ素が発生する","塩素が吸収されるだけ","白色沈殿が生じる"], extra:"酸化力 Cl₂＞Br₂ なので Cl₂ + 2KBr → 2KCl + Br₂。酸化力の強い方が単体をつくらせる"},
      {stem:"ハロゲン単体の沸点・融点について正しいものは", reading:"（ハロゲン）", answer:"原子番号が大きいほど高い（F₂＜Cl₂＜Br₂＜I₂）", wrong:["原子番号が大きいほど低い","すべて同じ","塩素が最も高い","フッ素が最も高い"], extra:"分子量が大きいほどファンデルワールス力が強く沸点が高い。酸化力の順とは逆"},
      {stem:"ハロゲン化水素のうち、水溶液が弱酸なのは", reading:"（ハロゲン化水素）", answer:"フッ化水素 HF", wrong:["塩化水素 HCl","臭化水素 HBr","ヨウ化水素 HI","すべて強酸"], extra:"HFのみ弱酸（水素結合のため）。酸の強さは HF≪HCl＜HBr＜HI で、原子半径が大きいほど強い"},
      {stem:"黄リンの保存方法として正しいものは", reading:"（リン）", answer:"自然発火するので水中に保存する", wrong:["石油中に保存する","乾燥空気中に保存する","アンモニア水中に保存する","加熱して保存する"], extra:"黄リンは有毒で約35℃で自然発火する。赤リンは比較的安定（マッチの側薬）"},
      {stem:"酢酸ナトリウムと水酸化ナトリウムの混合物を加熱すると発生する気体は", reading:"（メタンの製法）", answer:"メタン CH₄", wrong:["エタン C₂H₆","エチレン C₂H₄","アセチレン C₂H₂","二酸化炭素 CO₂"], extra:"CH₃COONa + NaOH → Na₂CO₃ + CH₄（脱炭酸）。メタンの実験室的製法"},
      {stem:"メタンと塩素の混合気体に光を照射すると起こる反応は", reading:"（置換反応）", answer:"水素原子が塩素原子に置き換わる置換反応", wrong:["二重結合への付加反応","脱離反応","縮合反応","重合反応"], extra:"光でCl₂がラジカルになり CH₃Cl、CH₂Cl₂…と順に置換が進む"},
      {stem:"分子式 C₄H₈ の炭化水素の構造異性体の数は（シス-トランスは区別しない）", reading:"（異性体）", answer:"5種類", wrong:["3種類","4種類","6種類","7種類"], extra:"1-ブテン・2-ブテン・2-メチルプロペン・シクロブタン・メチルシクロプロパン。2-ブテンにはシス-トランス異性体がある"},
      {stem:"酒石酸 HOOC-CH(OH)-CH(OH)-COOH の立体異性体の総数は", reading:"（立体異性体）", answer:"3種類（メソ体があるため）", wrong:["4種類","2種類","5種類","立体異性体はない"], extra:"不斉炭素2個で最大4種だが、分子内対称面をもつメソ体が1つあるため3種類になる"}
    ]
  },

  // ===== 化学2E14: C₄H₁₀O のアルコール・エステルの構造決定 =====
  {
    id:"cbeta_e_alcohol_ester",
    name:"C₄アルコールとエステルの構造決定",
    icon:"🧉",
    mode:"exam_chem",
    desc:"C₄H₁₀Oの異性体、ヨードホルム反応、エステルの元素分析",
    questions:[
      {stem:"分子式 C₄H₁₀O のアルコールの構造異性体の数は", reading:"（異性体）", answer:"4種類", wrong:["3種類","5種類","6種類","2種類"], extra:"1-ブタノール・2-ブタノール・2-メチル-1-プロパノール・2-メチル-2-プロパノール"},
      {stem:"C₄H₁₀O のアルコールのうち、沸点が最も高いものは", reading:"（沸点と構造）", answer:"1-ブタノール（直鎖の第一級）", wrong:["2-メチル-2-プロパノール","2-ブタノール","ジエチルエーテル","すべて同じ"], extra:"直鎖ほど分子間力が強く沸点が高い。枝分かれが多い第三級は最も低い"},
      {stem:"C₄H₁₀O のアルコールのうち、酸化するとアルデヒドを経てカルボン酸になるものはいくつあるか", reading:"（アルコールの酸化）", answer:"2つ（第一級アルコールの1-ブタノールと2-メチル-1-プロパノール）", wrong:["1つだけ","3つ","4つすべて","0（ない）"], extra:"第一級アルコールが2種あることに注意。第二級はケトンになり、第三級は酸化されにくい"},
      {stem:"2-ブタノール CH₃CH₂CH(OH)CH₃ の特徴として正しいものは", reading:"（不斉炭素・ヨードホルム）", answer:"不斉炭素原子を1つもち、ヨードホルム反応陽性である", wrong:["不斉炭素をもたない","ヨードホルム反応は陰性である","酸化するとカルボン酸になる","ナトリウムと反応しない"], extra:"CH₃CH(OH)- 構造をもつためヨードホルム反応陽性。C2位が不斉炭素"},
      {stem:"2-メチル-2-プロパノール（第三級アルコール）の性質として正しいものは", reading:"（第三級アルコール）", answer:"酸化されにくく、脱水すると1種類のアルケンのみを生じる", wrong:["酸化されてケトンになる","酸化されてカルボン酸になる","脱水すると3種類のアルケンを生じる","ナトリウムと反応しない"], extra:"脱水生成物は2-メチルプロペンのみ。第三級はO=Cをつくる水素がないため酸化されにくい"},
      {stem:"アルコールに金属ナトリウムを加えたときに発生する水素の量は、アルコール 1 mol あたり", reading:"（ナトリウムとの反応）", answer:"0.5 mol（1/2 mol）", wrong:["1 mol","2 mol","0.25 mol","発生しない"], extra:"2R-OH + 2Na → 2R-ONa + H₂。-OH 2個からH₂が1分子できる"},
      {stem:"炭素62.0%・水素10.4%・酸素27.6%（質量比）で分子量116の化合物の分子式は", reading:"（元素分析）", answer:"C₆H₁₂O₂", wrong:["C₅H₈O₃","C₆H₁₀O₂","C₄H₈O₂","C₇H₁₆O"], extra:"C:116×0.620/12=6.0、H:116×0.104/1=12、O:116×0.276/16=2.0"},
      {stem:"分子量116のエステルを加水分解すると分子量102のカルボン酸が得られた。もう一方の生成物のアルコールは", reading:"（エステルの構造決定）", answer:"メタノール（分子量32）", wrong:["エタノール（分子量46）","1-プロパノール","2-ブタノール","グリセリン"], extra:"エステル＝酸＋アルコール−水 なので 116＝102＋M−18 より M=32（メタノール）"},
      {stem:"メタノールの工業的製法として正しいものは", reading:"（メタノールの製法）", answer:"一酸化炭素と水素を触媒とともに加熱・加圧して合成する", wrong:["エチレンに水を付加する","糖のアルコール発酵で得る","酢酸を還元する","メタンに水を付加する"], extra:"CO + 2H₂ → CH₃OH。エタノールはエチレンの水付加や発酵で得る"},
      {stem:"焼いた銅線（酸化銅）をメタノールに近づけたときに生じる、刺激臭の物質は", reading:"（アルコールの酸化）", answer:"ホルムアルデヒド", wrong:["アセトン","アセトアルデヒド","ギ酸","ジメチルエーテル"], extra:"CuOがメタノールを酸化してHCHOが生じる。約37%水溶液がホルマリン"},
      {stem:"カルボン酸部分の分子式が C₄H₉COOH（分子量102）のとき、C₄H₉- の構造異性体の数は", reading:"（アルキル基の異性体）", answer:"4種類", wrong:["2種類","3種類","5種類","6種類"], extra:"ブチル・sec-ブチル・イソブチル・tert-ブチル。エステルの構造式の数え上げに使う"}
    ]
  },

  // ===== 化学2E21: 芳香族の総合（ベンゼン・キシレン・クメン法・C₇H₈O） =====
  {
    id:"cbeta_e_aromatic2",
    name:"芳香族総合・クメン法・C₇H₈O",
    icon:"🏵️",
    mode:"exam_chem",
    desc:"ベンゼンの構造・反応、キシレンの酸化、C₇H₈O異性体、サリチル酸メチル",
    questions:[
      {stem:"ベンゼンの炭素-炭素結合の距離について正しいものは", reading:"（ベンゼンの構造）", answer:"単結合（C-C）より短く、二重結合（C=C）より長い", wrong:["単結合より長く二重結合より短い","単結合と同じ","二重結合と同じ","結合ごとに長さが異なる"], extra:"6つの結合はすべて等価で、1.5結合的な中間の長さ。全原子が同一平面上にある"},
      {stem:"ベンゼンに紫外線を当てながら塩素を作用させると生じる物質は", reading:"（ベンゼンの付加）", answer:"ベンゼンヘキサクロリド（BHC）＝付加反応", wrong:["クロロベンゼン（置換反応）","o-ジクロロベンゼン","塩化ベンジル","フェノール"], extra:"光では付加、鉄触媒では置換（クロロベンゼン）。条件で反応が変わる"},
      {stem:"酸化バナジウム(V)を触媒にベンゼンを空気酸化すると得られる物質は", reading:"（ベンゼンの酸化）", answer:"無水マレイン酸", wrong:["無水フタル酸","フェノール","安息香酸","マレイン酸のまま"], extra:"ベンゼン→無水マレイン酸、ナフタレン/o-キシレン→無水フタル酸（いずれもV₂O₅触媒）"},
      {stem:"ニトロベンゼンの性質として正しいものは", reading:"（ニトロベンゼン）", answer:"特有の芳香をもつ淡黄色の液体で、水より重い", wrong:["無色の気体である","水によく溶ける白色固体","水より軽い赤色液体","昇華性のある固体"], extra:"水に溶けにくく、水に加えると底に沈む"},
      {stem:"分子式 C₈H₁₀ の芳香族化合物の構造異性体の数は", reading:"（異性体）", answer:"4種類", wrong:["3種類","5種類","6種類","2種類"], extra:"エチルベンゼンと o-・m-・p-キシレンの4種"},
      {stem:"エチルベンゼンを過マンガン酸カリウムで酸化すると得られる化合物は", reading:"（側鎖の酸化）", answer:"安息香酸", wrong:["フタル酸","テレフタル酸","フェノール","ベンズアルデヒド"], extra:"側鎖はどんな長さでも酸化されて-COOHになる。エチル基1本→-COOH1本"},
      {stem:"o-キシレンを酸化して得られ、加熱すると分子内脱水して酸無水物になる化合物は", reading:"（キシレンの酸化）", answer:"フタル酸", wrong:["テレフタル酸","イソフタル酸","安息香酸","マレイン酸"], extra:"o-位の2つの-COOHが近いため無水フタル酸になる。p-キシレンからはテレフタル酸（PET原料）"},
      {stem:"クメン法でベンゼンと反応させる化合物Dと、フェノールと同時に得られる化合物の正しい組合せは", reading:"（クメン法）", answer:"D＝プロペン、同時生成物＝アセトン", wrong:["D＝エチレン、同時生成物＝アセトアルデヒド","D＝プロパン、同時生成物＝酢酸","D＝スチレン、同時生成物＝アセトン","D＝プロペン、同時生成物＝酢酸"], extra:"ベンゼン+プロペン→クメン→（空気酸化・分解）→フェノール+アセトン"},
      {stem:"分子式 C₇H₈O の芳香族化合物の構造異性体の数は", reading:"（異性体）", answer:"5種類", wrong:["3種類","4種類","6種類","7種類"], extra:"ベンジルアルコール・o/m/p-クレゾール・アニソール（メチルフェニルエーテル）"},
      {stem:"C₇H₈O の芳香族化合物のうち、水酸化ナトリウム水溶液に溶けるものはいくつあるか", reading:"（酸性の判定）", answer:"3つ（o・m・p-クレゾール）", wrong:["1つ（ベンジルアルコール）","4つ","5つすべて","0（ない）"], extra:"フェノール類のクレゾールだけが酸性でNaOHに溶ける。ベンジルアルコールは中性"},
      {stem:"C₇H₈O の芳香族化合物のうち、金属ナトリウムと反応しないものは", reading:"（-OHの判定）", answer:"アニソール（エーテルで-OHをもたない）", wrong:["ベンジルアルコール","o-クレゾール","p-クレゾール","すべて反応する"], extra:"Na と反応するのは-OHをもつ4種。エーテルは反応しない"},
      {stem:"サリチル酸とメタノールからサリチル酸メチルを合成するとき、濃硫酸のはたらきは", reading:"（エステル化）", answer:"エステル化反応の触媒", wrong:["酸化剤","還元剤","乾燥剤としてのみ","中和剤"], extra:"少量の濃硫酸が触媒。突沸防止に沸騰石も入れる"},
      {stem:"サリチル酸メチルの合成後、未反応のサリチル酸を除くために反応液を注ぐ水溶液は", reading:"（分離操作）", answer:"飽和炭酸水素ナトリウム水溶液", wrong:["水酸化ナトリウム水溶液（エステルもけん化されるため不可）","希塩酸","飽和食塩水","石灰水"], extra:"NaHCO₃はカルボン酸だけを塩にして水層へ。強塩基NaOHではエステルまでけん化してしまう"},
      {stem:"サリチル酸メチルの検出に使える試薬と呈色は", reading:"（フェノール性-OHの検出）", answer:"塩化鉄(III)水溶液で赤紫色", wrong:["フェーリング液で赤色沈殿","ヨウ素溶液で青紫色","石灰水で白濁","ニンヒドリンで紫色"], extra:"サリチル酸メチルはフェノール性-OHが残っているためFeCl₃で呈色する。消炎剤（湿布）の成分"}
    ]
  },

  // ===== 化学2E22: アニリン・油脂の計算・糖類 =====
  {
    id:"cbeta_e_aniline_fat_sugar",
    name:"アニリン・油脂の計算・糖類",
    icon:"🍭",
    mode:"exam_chem",
    desc:"アニリンの反応、けん化価・ヨウ素価の考え方、単糖・二糖・多糖",
    questions:[
      {stem:"ニトロベンゼンをスズと濃塩酸で還元したあと、アニリンを遊離させるために加えるものは", reading:"（アニリンの製法）", answer:"水酸化ナトリウム水溶液", wrong:["希塩酸","炭酸水素ナトリウム水溶液","硫酸","アンモニア水"], extra:"還元直後はアニリン塩酸塩。強塩基NaOHで弱塩基のアニリンが遊離する"},
      {stem:"アニリンを次亜塩素酸カルシウム（さらし粉）水溶液に加えたときの呈色は", reading:"（アニリンの検出）", answer:"赤紫色", wrong:["青紫色","黄色","緑色","無色のまま"], extra:"さらし粉による酸化で赤紫色。アニリンの検出反応として有名"},
      {stem:"アニリンに無水酢酸を作用させて得られるアセトアニリドがもつ結合は", reading:"（アセチル化）", answer:"アミド結合", wrong:["エステル結合","エーテル結合","アゾ基","ジスルフィド結合"], extra:"-NH-CO- がアミド結合。アセトアニリドは中性物質で解熱剤として使われた"},
      {stem:"油脂 1 mol を完全にけん化するのに必要な水酸化カリウムの物質量は", reading:"（けん化の量的関係）", answer:"3 mol", wrong:["1 mol","2 mol","4 mol","6 mol"], extra:"油脂は3価エステルなのでKOHは3倍必要。この関係から油脂の分子量が求まる（けん化価）"},
      {stem:"油脂に付加するヨウ素 I₂ の量からわかるものは", reading:"（ヨウ素価）", answer:"油脂中の C=C 二重結合の数（不飽和度）", wrong:["エステル結合の数","油脂の分子量","脂肪酸の炭素数","グリセリンの量"], extra:"C=C 1個にI₂が1分子付加する。ヨウ素価が大きいほど不飽和度が高く乾性油に近い"},
      {stem:"リノール酸 C₁₇H₃₁COOH 1分子がもつ C=C 二重結合の数は", reading:"（脂肪酸）", answer:"2個", wrong:["1個","3個","0個","6個"], extra:"飽和はC₁₇H₃₅COOH（ステアリン酸）。H数が2減るごとにC=Cが1個増える（C₁₇H₃₃=オレイン酸1個、C₁₇H₂₉=リノレン酸3個）"},
      {stem:"グルコースの水溶液中での存在の仕方として正しいものは", reading:"（グルコースの平衡）", answer:"α型・β型の環状分子と鎖状分子が平衡混合物として存在する", wrong:["α型の環状分子のみで存在する","鎖状分子のみで存在する","β型に完全に変化する","二量体として存在する"], extra:"鎖状構造のホルミル基が還元性のもと。α-D-グルコースとβ-D-グルコースは1位の-OHの向きが違う"},
      {stem:"二糖類のうち、還元性を示さないものは", reading:"（二糖類）", answer:"スクロース", wrong:["マルトース","ラクトース","セロビオース","すべて還元性を示す"], extra:"スクロースは還元性を示す部分どうしで結合しているため非還元糖。加水分解した転化糖は還元性を示す"},
      {stem:"スクロースを加水分解する酵素は", reading:"（酵素）", answer:"インベルターゼ（スクラーゼ）", wrong:["アミラーゼ","マルターゼ","セルラーゼ","リパーゼ"], extra:"スクロース→グルコース+フルクトース（転化糖）。アミラーゼはデンプン、セルラーゼはセルロースを分解"},
      {stem:"デンプンの成分のうち、直鎖状でらせん構造をとり、温水に溶けやすいものは", reading:"（デンプン）", answer:"アミロース", wrong:["アミロペクチン","グリコーゲン","セルロース","マルトース"], extra:"アミロースは直鎖（α1,4結合のみ）。アミロペクチンは枝分かれ（α1,6結合も）をもち溶けにくい"},
      {stem:"動物の肝臓や筋肉に蓄えられ「動物デンプン」ともよばれる多糖は", reading:"（多糖類）", answer:"グリコーゲン", wrong:["セルロース","アミロース","キチン","イヌリン"], extra:"グリコーゲンはアミロペクチンよりさらに枝分かれが多い構造"},
      {stem:"ビスコースレーヨンやキュプラの原料と分類の正しい説明は", reading:"（再生繊維）", answer:"セルロースを溶かして再び繊維にした再生繊維である", wrong:["セルロースを原料とした半合成繊維である","石油を原料とした合成繊維である","タンパク質を原料とした天然繊維である","グルコースを重合させた合成繊維である"], extra:"化学変化させず溶解→再生するので再生繊維。アセテートは半合成繊維"},
      {stem:"セルロースに濃硝酸と濃硫酸の混合物を作用させて得られる、火薬にも使われる物質は", reading:"（セルロースの利用）", answer:"トリニトロセルロース（硝酸エステル）", wrong:["トリアセチルセルロース","ビスコース","ニトロベンゼン","無水フタル酸"], extra:"-OHが硝酸エステル化される。ニトロ化合物ではなく硝酸エステルである点に注意"}
    ]
  },

  // ===== 化学2E23: アミノ酸の平衡・等電点・核酸 =====
  {
    id:"cbeta_e_amino_nucleic",
    name:"アミノ酸の等電点・核酸",
    icon:"🧬",
    mode:"exam_chem",
    desc:"双性イオン・等電点・電気泳動・イオン交換樹脂、DNA/RNA",
    questions:[
      {stem:"タンパク質を構成するα-アミノ酸のうち、不斉炭素原子をもたないものの分子式は", reading:"（グリシン）", answer:"C₂H₅NO₂（グリシン）", wrong:["C₃H₇NO₂（アラニン）","C₂H₃NO₂","C₃H₇NO₃","C₃H₅NO₂"], extra:"グリシン H₂N-CH₂-COOH は側鎖がHなので不斉炭素をもたない"},
      {stem:"アミノ酸が結晶中でとる、正電荷と負電荷をあわせもつイオンの形を何というか", reading:"（双性イオン）", answer:"双性イオン", wrong:["錯イオン","多価イオン","ラジカル","分子内塩ではない中性分子"], extra:"-COO⁻ と -NH₃⁺ を同時にもつ。融点が高く水に溶けやすい理由"},
      {stem:"アミノ酸の電荷の総和が0になるpHを何というか。2つの電離定数K₁・K₂から求める式は", reading:"（等電点）", answer:"等電点。pI＝(pK₁＋pK₂)/2", wrong:["中和点。pI＝pK₁＋pK₂","当量点。pI＝pK₁×pK₂","等電点。pI＝pK₂−pK₁","緩衝点。pI＝(pK₂−pK₁)/2"], extra:"陽イオン⇄双性イオン⇄陰イオンの平衡の中間。グリシンは約6"},
      {stem:"等電点より低いpH（酸性側）の緩衝液中で、アミノ酸を電気泳動するとどちらに移動するか", reading:"（電気泳動）", answer:"陽イオンになっているので陰極へ移動する", wrong:["陽極へ移動する","移動しない","両極へ半分ずつ移動する","分解する"], extra:"pH＜pI では -NH₃⁺ 型の陽イオンが多い。pH＝pI では移動しない"},
      {stem:"酸性の溶液に溶かしたアミノ酸を陽イオン交換樹脂のカラムに通すとどうなるか", reading:"（イオン交換樹脂）", answer:"陽イオンとして樹脂に吸着され、流出液にはほとんど含まれない", wrong:["陰イオンとして素通りする","樹脂を溶かしてしまう","樹脂と共有結合する","中性分子として流出する"], extra:"酸性ではアミノ酸は陽イオン型。アミノ酸の分離・精製に使われる"},
      {stem:"ビウレット反応について正しいものは", reading:"（呈色反応）", answer:"ペプチド結合が2個以上（トリペプチド以上）ないと呈色しない", wrong:["アミノ酸1分子でも呈色する","ジペプチドで最もよく呈色する","ベンゼン環がないと呈色しない","硫黄がないと呈色しない"], extra:"アミノ酸単体やジペプチドでは呈色しない点がよく問われる"},
      {stem:"システインを含むタンパク質にNaOHを加えて加熱し、酢酸で中和後に酢酸鉛(II)を加えると生じる黒色沈殿は", reading:"（硫黄の検出）", answer:"硫化鉛 PbS", wrong:["酸化鉛 PbO","硫酸鉛 PbSO₄","塩化鉛 PbCl₂","鉛単体"], extra:"含硫アミノ酸（システイン・メチオニン）の検出。グリシンやアラニンでは沈殿しない"},
      {stem:"DNAを構成する糖（デオキシリボース）の分子式は", reading:"（核酸の糖）", answer:"C₅H₁₀O₄", wrong:["C₅H₁₀O₅（リボース）","C₆H₁₂O₆","C₅H₈O₄","C₆H₁₀O₅"], extra:"リボース C₅H₁₀O₅ から酸素が1つ少ない（デオキシ＝脱酸素）"},