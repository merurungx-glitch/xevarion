  // ===== 化学120: 希薄溶液の性質・コロイド =====
  {
    id:"cbeta_solution_colloid",
    name:"希薄溶液の性質・コロイド",
    icon:"🧪",
    mode:"exam_chem",
    desc:"凝固点降下・沸点上昇・浸透圧・コロイドの性質",
    questions:[
      {stem:"不揮発性物質を溶かした希薄溶液で、純溶媒より凝固点が下がる現象を何というか", reading:"（束一的性質）", answer:"凝固点降下", wrong:["沸点上昇","浸透圧","蒸気圧上昇","融解熱","過冷却"], extra:"溶質粒子により凝固点が下がる。自動車の不凍液や路面の凍結防止（塩化カルシウム）に利用"},
      {stem:"食塩水が純水より高い温度で沸騰するのは、次のどの現象によるか", reading:"（束一的性質）", answer:"沸点上昇", wrong:["凝固点降下","浸透圧","蒸気圧上昇","中和熱","昇華"], extra:"不揮発性の溶質を溶かすと蒸気圧が下がり、沸点が上がる"},
      {stem:"ナメクジに塩をかけると縮む、梅酒の梅がしぼむ現象に共通して関係するものは", reading:"（束一的性質）", answer:"浸透（圧）", wrong:["凝固点降下","沸点上昇","中和","電気泳動","チンダル現象"], extra:"半透膜を隔てて濃度の低い側から高い側へ溶媒が移動する"},
      {stem:"路上の凍結防止に塩化カルシウムをまくのは、次のどの性質を利用しているか", reading:"（束一的性質）", answer:"凝固点降下", wrong:["沸点上昇","浸透圧","潮解","昇華","風解"], extra:"電解質は電離して粒子数が増えるため凝固点降下が大きい"},
      {stem:"希薄溶液の浸透圧πと、モル濃度C・絶対温度Tの関係を表す式は（Rは気体定数）", reading:"（ファントホッフの法則）", answer:"π = CRT", wrong:["π = CRT²","πC = RT","π = RT/C","π = C/RT","πV = nRT²"], extra:"ファントホッフの法則。理想気体の状態方程式と同じ形。πV=nRTとも書ける"},
      {stem:"親水コロイドを沈殿させるには、どのような操作が必要か", reading:"（塩析）", answer:"多量の電解質を加える", wrong:["少量の電解質を加える","反対電荷の多価イオンを少量加える","半透膜で透析する","光を当てる","加熱するだけでよい"], extra:"親水コロイドの沈殿を塩析という。多量の電解質でコロイド粒子の水和水を奪う"},
      {stem:"疎水コロイドを凝析させるのに最も有効なのは", reading:"（凝析）", answer:"コロイドと反対の電荷をもつ多価イオンの溶液", wrong:["同符号の電荷をもつ多価イオン","多量の非電解質","純水","保護コロイド"], extra:"疎水コロイドは少量の電解質（特に反対電荷の価数が大きいイオン）で凝析する"},
      {stem:"疎水コロイドに加えて凝析しにくくするために用いる親水コロイドを何というか", reading:"（コロイド）", answer:"保護コロイド", wrong:["疎水コロイド","会合コロイド","分散コロイド","ゾル","ゲル"], extra:"墨汁のにかわ、絵の具のゼラチンなど。疎水コロイドを親水コロイドが取り囲んで安定化"},
      {stem:"コロイド溶液に横から強い光を当てると光の通路が輝いて見える現象を何というか", reading:"（コロイドの性質）", answer:"チンダル現象", wrong:["ブラウン運動","電気泳動","透析","浸透"], extra:"コロイド粒子が光を散乱するために起こる"},
      {stem:"半透膜を用いて、コロイド溶液から小さな分子やイオンを除く操作を何というか", reading:"（コロイドの精製）", answer:"透析", wrong:["塩析","凝析","電気泳動","ろ過"], extra:"人工透析にも応用。コロイド粒子は半透膜を通れないが小分子・イオンは通る"},
      {stem:"限外顕微鏡でコロイド粒子が不規則に動いて見える運動を何というか", reading:"（コロイドの性質）", answer:"ブラウン運動", wrong:["チンダル現象","電気泳動","対流","拡散"], extra:"分散媒（溶媒）分子がコロイド粒子に不規則に衝突するために起こる"},
      {stem:"コロイド溶液に直流電圧をかけるとコロイド粒子が一方の電極へ移動する現象を何というか", reading:"（コロイドの性質）", answer:"電気泳動", wrong:["ブラウン運動","チンダル現象","透析","塩析"], extra:"コロイド粒子が電荷を帯びているため。移動方向から粒子の電荷の符号がわかる"}
    ]
  },

  // ===== 化学201・202: イオンの色・沈殿・錯イオン =====
  {
    id:"cbeta_ion_color_precip",
    name:"イオンの色・沈殿・錯イオン",
    icon:"🌈",
    mode:"exam_chem",
    desc:"金属イオンの色・沈殿の色・錯イオンの識別",
    questions:[
      {stem:"クロム酸イオン CrO₄²⁻ を含む水溶液の色は", reading:"（イオンの色）", answer:"黄色", wrong:["赤紫色","青色","緑色","赤橙色"], extra:"二クロム酸イオン Cr₂O₇²⁻ は橙赤色。塩基性でクロム酸イオン（黄）に変化する"},
      {stem:"過マンガン酸イオン MnO₄⁻ を含む水溶液の色は", reading:"（イオンの色）", answer:"赤紫色", wrong:["黄色","青色","緑色","無色"], extra:"KMnO₄ は酸性で強い酸化剤。反応後は Mn²⁺（ほぼ無色）になる"},
      {stem:"鉄(III)イオン Fe³⁺ を含む水溶液の色は", reading:"（イオンの色）", answer:"黄褐色", wrong:["青色","淡緑色","赤紫色","無色"], extra:"Fe²⁺ は淡緑色。Fe³⁺ にチオシアン酸カリウムを加えると血赤色になる"},
      {stem:"銅(II)イオン Cu²⁺ の水和イオンを含む水溶液の色は", reading:"（イオンの色）", answer:"青色", wrong:["緑色","黄色","赤色","無色"], extra:"[Cu(H₂O)₄]²⁺ は青色。アンモニア錯イオン [Cu(NH₃)₄]²⁺ は深青色"},
      {stem:"Cu²⁺ に H₂S を通じると生じる沈殿の色は", reading:"（硫化物の沈殿）", answer:"黒色", wrong:["白色","黄色","赤褐色","青白色"], extra:"CuS は黒色沈殿。酸性でも沈殿する（イオン化傾向の小さい金属の硫化物）"},
      {stem:"Zn²⁺ に塩基性下で H₂S を通じると生じる沈殿の色は", reading:"（硫化物の沈殿）", answer:"白色", wrong:["黒色","黄色","赤褐色","緑色"], extra:"ZnS は白色沈殿。Zn²⁺ は中〜塩基性でのみ硫化物が沈殿する"},
      {stem:"Fe³⁺ に水酸化ナトリウム水溶液を加えると生じる沈殿の色は", reading:"（水酸化物の沈殿）", answer:"赤褐色", wrong:["白色","黒色","青白色","緑白色"], extra:"水酸化鉄(III) は赤褐色。Fe²⁺ の水酸化鉄(II) は緑白色"},
      {stem:"Cu²⁺ に少量の水酸化ナトリウム水溶液を加えると生じる沈殿の色は", reading:"（水酸化物の沈殿）", answer:"青白色", wrong:["黒色","白色","赤褐色","黄色"], extra:"水酸化銅(II) Cu(OH)₂ は青白色。過剰のアンモニアで深青色の錯イオンとなり溶ける"},
      {stem:"Ba²⁺ に炭酸アンモニウム水溶液を加えると生じる沈殿の色は", reading:"（炭酸塩の沈殿）", answer:"白色", wrong:["黒色","黄色","赤褐色","青色"], extra:"炭酸バリウム BaCO₃ は白色沈殿。Ca²⁺ の CaCO₃ も白色"},
      {stem:"Cu²⁺ に多数の水分子が結びついた水和イオンをつくる結合は", reading:"（配位結合）", answer:"配位結合", wrong:["イオン結合","水素結合","金属結合","共有結合（非共有電子対を使わない）"], extra:"水分子やアンモニアの非共有電子対が金属イオンに配位して錯イオンをつくる"},
      {stem:"Ag⁺ を含む水溶液に過剰のアンモニア水を加えると生じる錯イオンは", reading:"（錯イオン）", answer:"[Ag(NH₃)₂]⁺", wrong:["[Ag(NH₃)₄]²⁺","[AgCl₂]⁻","[Ag(OH)₂]⁻","[Ag(NH₃)₄]⁺"], extra:"銀アンモニア錯イオンは配位数2の直線形。ジアンミン銀(I)イオン"},
      {stem:"クロム酸銀 Ag₂CrO₄ の沈殿の色は", reading:"（クロム酸塩の沈殿）", answer:"暗赤色（赤褐色）", wrong:["黄色","白色","黒色","青色"], extra:"クロム酸鉛 PbCrO₄ とクロム酸バリウム BaCrO₄ は黄色。銀のクロム酸塩は暗赤色"}
    ]
  },

  // ===== 化学202: 両性金属・金属と酸・不動態 =====
  {
    id:"cbeta_amphoteric_acid",
    name:"両性金属・金属と酸・不動態",
    icon:"⚗️",
    mode:"exam_chem",
    desc:"両性金属、酸との反応、不動態、王水",
    questions:[
      {stem:"水酸化ナトリウム水溶液を過剰に加えると沈殿が溶ける（両性水酸化物をつくる）金属イオンの組は", reading:"（両性金属）", answer:"Al³⁺・Zn²⁺・Pb²⁺", wrong:["Fe³⁺・Cu²⁺・Ag⁺","Ca²⁺・Ba²⁺・Mg²⁺","Cu²⁺・Zn²⁺・Ag⁺","Fe²⁺・Ni²⁺・Mn²⁺"], extra:"両性金属は Al・Zn・Sn・Pb。強酸にも強塩基にも溶ける"},
      {stem:"過剰のアンモニア水を加えると錯イオンをつくって沈殿が溶ける金属イオンの組は", reading:"（アンモニア錯イオン）", answer:"Cu²⁺・Zn²⁺・Ag⁺", wrong:["Al³⁺・Fe³⁺・Pb²⁺","Ca²⁺・Ba²⁺・Mg²⁺","Fe²⁺・Fe³⁺・Al³⁺","Pb²⁺・Sn²⁺・Al³⁺"], extra:"Cu²⁺・Zn²⁺・Ag⁺・Ni²⁺ はアンモニア錯イオンをつくる。Al(OH)₃・Fe(OH)₃ は過剰NH₃では溶けない"},
      {stem:"銅 Cu や銀 Ag が溶けるのはどれか", reading:"（金属と酸）", answer:"熱濃硫酸・硝酸", wrong:["希硫酸","希塩酸","炭酸水","水酸化ナトリウム水溶液"], extra:"Cu・Ag は水素よりイオン化傾向が小さく、酸化力のある酸（熱濃硫酸・硝酸）にのみ溶ける"},
      {stem:"アルミニウム Al や鉄 Fe が濃硝酸に溶けにくいのは、表面にどのような状態が生じるためか", reading:"（不動態）", answer:"不動態（緻密な酸化被膜）", wrong:["両性水酸化物","アマルガム","錯イオン","塩化物の被膜"], extra:"Al・Fe・Ni は濃硝酸で表面に緻密な酸化被膜ができ、反応が止まる（不動態）"},
      {stem:"金 Au や白金 Pt を溶かすことができる、濃塩酸と濃硝酸を体積比3:1で混ぜた溶液を何というか", reading:"（王水）", answer:"王水", wrong:["希王水","逆王水","混酸","発煙硫酸"], extra:"王水は濃塩酸:濃硝酸=3:1。イオン化傾向の非常に小さい Au・Pt も溶かす"},
      {stem:"ナトリウム Na やカルシウム Ca が常温の水と反応すると発生する気体は", reading:"（アルカリ・アルカリ土類金属）", answer:"水素", wrong:["酸素","二酸化炭素","塩素","一酸化炭素"], extra:"2Na + 2H₂O → 2NaOH + H₂。イオン化傾向の大きい金属は常温で水と反応する"},
      {stem:"Cu²⁺ を含む青色水溶液に少量の NaOH を加えると青白色沈殿が生じ、H₂S を通じると何色の沈殿になるか", reading:"（銅の反応）", answer:"黒色（CuS）", wrong:["白色","赤褐色","黄色","緑色"], extra:"Cu(OH)₂（青白）→ CuS（黒）。Cu²⁺ と Zn²⁺ の区別に利用できる"},
      {stem:"銅に濃硝酸を加えて加熱すると発生する気体は", reading:"（金属と硝酸）", answer:"二酸化窒素 NO₂", wrong:["一酸化窒素 NO","水素 H₂","二酸化硫黄 SO₂","酸素 O₂"], extra:"濃硝酸では NO₂（赤褐色）、希硝酸では NO（無色）が発生する"},
      {stem:"塩化コバルト(II)の無水物が吸湿すると起こる色の変化は", reading:"（水分の検出）", answer:"青色 → 赤（桃）色", wrong:["赤色 → 青色","無色 → 黄色","白色 → 黒色","緑色 → 青色"], extra:"無水 CoCl₂ は青色、水和すると赤桃色。乾燥剤（シリカゲル）の水分検出に使われる"}
    ]
  },

  // ===== 化学203: 系統分離・気体の性質と製法 =====
  {
    id:"cbeta_gas_analysis",
    name:"気体の性質・製法・系統分離",
    icon:"💨",
    mode:"exam_chem",
    desc:"金属イオンの系統分離、気体の性質・捕集・乾燥",
    questions:[
      {stem:"Pb²⁺・Ag⁺ を含む水溶液に希塩酸を加えると生じる白色沈殿は", reading:"（系統分離 第1属）", answer:"塩化鉛 PbCl₂・塩化銀 AgCl", wrong:["硫化鉛 PbS","水酸化鉛 Pb(OH)₂","硫酸鉛 PbSO₄ のみ","炭酸鉛 PbCO₃"], extra:"系統分離ではまず希塩酸で Ag⁺・Pb²⁺ を塩化物として沈殿させる"},
      {stem:"Al³⁺・Fe³⁺ の混合水酸化物沈殿に水酸化ナトリウムを過剰に加えると、溶けずに残る沈殿は", reading:"（系統分離）", answer:"水酸化鉄(III) Fe(OH)₃", wrong:["水酸化アルミニウム Al(OH)₃","両方溶ける","両方残る","水酸化亜鉛 Zn(OH)₂"], extra:"Al(OH)₃ は両性で過剰NaOHに溶けるが、Fe(OH)₃ は溶けずに赤褐色沈殿として残る"},
      {stem:"無色・無臭で有毒、高温で還元力が強く鉄の製錬に用いられる気体は", reading:"（気体の性質）", answer:"一酸化炭素 CO", wrong:["二酸化炭素 CO₂","一酸化窒素 NO","二酸化窒素 NO₂","二酸化硫黄 SO₂"], extra:"CO は溶鉱炉で酸化鉄を還元する。無色無臭で有毒（血液中のヘモグロビンと結合）"},
      {stem:"刺激臭のある無色・有毒な気体で、還元性があり漂白作用をもつものは", reading:"（気体の性質）", answer:"二酸化硫黄 SO₂", wrong:["塩素 Cl₂","二酸化炭素 CO₂","一酸化炭素 CO","二酸化窒素 NO₂"], extra:"SO₂ は還元性を示し漂白作用がある。水に溶けて亜硫酸となり酸性"},
      {stem:"刺激臭のある赤褐色の気体で、水溶液が酸性を示すものは", reading:"（気体の性質）", answer:"二酸化窒素 NO₂", wrong:["塩素 Cl₂","二酸化硫黄 SO₂","一酸化窒素 NO","アンモニア NH₃"], extra:"NO₂ は赤褐色・刺激臭。一酸化窒素 NO は無色で、空気中で酸化されて NO₂ になる"},
      {stem:"二酸化炭素 CO₂ の捕集法として正しいものは", reading:"（気体の捕集）", answer:"下方置換", wrong:["上方置換","水上置換のみ可","上方・水上どちらも不可","加熱捕集"], extra:"CO₂ は空気より重く水に少し溶けるので下方置換。乾燥は濃硫酸などを用いる"},
      {stem:"アンモニア NH₃ の捕集法と乾燥剤の正しい組合せは", reading:"（気体の捕集・乾燥）", answer:"上方置換・ソーダ石灰", wrong:["下方置換・濃硫酸","水上置換・塩化カルシウム","上方置換・濃硫酸","下方置換・ソーダ石灰"], extra:"NH₃ は空気より軽く水に非常に溶けるので上方置換。塩基性なので酸性の濃硫酸では乾燥できない"},
      {stem:"酸化マンガン(IV)を触媒として過酸化水素水を分解して得られる気体は", reading:"（気体の製法）", answer:"酸素 O₂", wrong:["水素 H₂","二酸化炭素 CO₂","塩素 Cl₂","オゾン O₃"], extra:"2H₂O₂ → 2H₂O + O₂（MnO₂ は触媒）。水上置換で捕集し、乾燥は塩化カルシウム"},
      {stem:"亜鉛に希硫酸を反応させて得られる気体は", reading:"（気体の製法）", answer:"水素 H₂", wrong:["酸素 O₂","二酸化硫黄 SO₂","硫化水素 H₂S","二酸化炭素 CO₂"], extra:"Zn + H₂SO₄ → ZnSO₄ + H₂。水上置換で捕集"},
      {stem:"塩化アンモニウムと水酸化カルシウムを混合して加熱すると発生する気体は", reading:"（気体の製法）", answer:"アンモニア NH₃", wrong:["塩素 Cl₂","塩化水素 HCl","窒素 N₂","二酸化炭素 CO₂"], extra:"2NH₄Cl + Ca(OH)₂ → CaCl₂ + 2H₂O + 2NH₃。上方置換で捕集、乾燥はソーダ石灰"}
    ]
  },

  // ===== 化学204: アルカリ金属・2族・アンモニアソーダ法 =====
  {
    id:"cbeta_alkali_soda",
